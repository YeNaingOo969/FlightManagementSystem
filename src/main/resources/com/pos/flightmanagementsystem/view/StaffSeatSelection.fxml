<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="rootStackPane" stylesheets="@/com/pos/flightmanagementsystem/Style/StaffSeatSelectionDark.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.StaffSeatSelectionController">
    <children>
        <VBox fx:id="mainContainer" prefHeight="760.0" prefWidth="1280.0" spacing="15.0" styleClass="main-content-vbox">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-card">
                    <padding><Insets bottom="10.0" left="25.0" right="25.0" top="10.0" /></padding>
                    <children>
                        <StackPane styleClass="header-icon-container">
                            <SVGPath content="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z" styleClass="header-icon-glyph" />
                        </StackPane>
                        <VBox alignment="CENTER_LEFT">
                            <Label styleClass="header-title-label" text="Seat Selection" />
                            <Label styleClass="header-subtitle-label" text="Choose preferred seats for your passengers" />
                        </VBox>
                    </children>
                </HBox>

                <!-- TOP BAR -->
                <HBox alignment="CENTER_LEFT" spacing="25.0" styleClass="layout-card">
                    <padding><Insets bottom="10.0" left="25.0" right="25.0" top="10.0" /></padding>
                    <children>
                        <Label fx:id="lblTopFlight" styleClass="flight-info-text" text="Flight: --" />
                        <Label fx:id="lblTopRoute" styleClass="flight-info-text" text="-- ➔ --" />
                        <Label fx:id="lblTopDate" styleClass="flight-info-text" text="Date: --" />
                        <Label fx:id="lblTopTime" styleClass="flight-info-text" text="Time: --" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="classComboBox" prefWidth="220.0" promptText="Select Class" styleClass="custom-combo-box" />
                    </children>
                </HBox>

                <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Plane Fuselage Area -->
                        <VBox alignment="CENTER" prefWidth="780.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="viewport-container">
                            <Pane fx:id="viewportPane" prefHeight="550.0" prefWidth="780.0" maxWidth="780.0" VBox.vgrow="ALWAYS">
                                <VBox fx:id="sideViewPlane" alignment="CENTER" prefHeight="550.0" prefWidth="780.0" layoutY="0.0">
                                    <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill="#94a3b8" scaleX="8.0" scaleY="8.0" />
                                    <Label styleClass="placeholder-text" text="Select a class to view interior" />
                                </VBox>

                                <StackPane fx:id="topViewPlane" alignment="TOP_CENTER" opacity="0.0" prefWidth="780.0">
                                    <SVGPath content="M 200 0 L 0 250 L 0 290 L 200 120 Z" styleClass="plane-wing" StackPane.alignment="TOP_LEFT" translateY="520" />
                                    <SVGPath content="M 0 0 L 200 250 L 200 290 L 0 120 Z" styleClass="plane-wing" StackPane.alignment="TOP_RIGHT" translateY="520" />

                                    <VBox alignment="TOP_CENTER" prefWidth="380.0" maxWidth="380.0" spacing="15.0" styleClass="fuselage">
                                        <padding><Insets bottom="60.0" top="20.0" /></padding>
                                        <VBox alignment="CENTER" prefHeight="60.0" prefWidth="160.0" maxWidth="160.0" styleClass="cockpit">
                                            <Label styleClass="cockpit-label" text="PILOT COCKPIT" />
                                        </VBox>

                                        <HBox alignment="CENTER" spacing="15.0">
                                            <Label prefWidth="45.0" alignment="CENTER" styleClass="seat-header-label" text="A" />
                                            <Label prefWidth="45.0" alignment="CENTER" styleClass="seat-header-label" text="B" />
                                            <Region prefWidth="40.0" />
                                            <Label prefWidth="45.0" alignment="CENTER" styleClass="seat-header-label" text="C" />
                                            <Label prefWidth="45.0" alignment="CENTER" styleClass="seat-header-label" text="D" />
                                        </HBox>

                                        <VBox fx:id="businessSection" alignment="CENTER" spacing="15.0">
                                            <Label styleClass="class-title" text="Business Class" />
                                        </VBox>

                                        <VBox fx:id="premiumSection" alignment="CENTER" spacing="15.0">
                                            <Separator styleClass="class-separator" />
                                            <Label styleClass="class-title" text="Premium Economic" />
                                        </VBox>

                                        <VBox fx:id="economySection" alignment="CENTER" spacing="15.0">
                                            <Separator styleClass="class-separator" />
                                            <Label styleClass="class-title" text="Economic" />
                                        </VBox>
                                    </VBox>
                                </StackPane>
                            </Pane>
                        </VBox>

                        <!-- RIGHT SIDE: Summary Card -->
                        <VBox prefWidth="500.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" spacing="15.0">
                            <VBox spacing="12.0" styleClass="layout-card, summary-card" VBox.vgrow="ALWAYS">
                                <Label styleClass="section-title" text="Selected Seats" />

                                <VBox alignment="CENTER" styleClass="selected-seat-box">
                                    <Label fx:id="lblSelectedSeat" styleClass="selected-seat-large" text="--" />
                                </VBox>

                                <Separator styleClass="summary-separator" />

                                <VBox spacing="8.0">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="summary-label" text="Total Passengers" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblPassengerName" styleClass="summary-value" text="--" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="summary-label" text="Base Ticket Price" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblTicketPrice" styleClass="summary-value" text="0 MMK" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="summary-label" text="Extra Seat Charge" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblSeatCharge" styleClass="summary-value" text="0 MMK" />
                                    </HBox>
                                </VBox>

                                <Separator styleClass="summary-separator" />

                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="summary-total-label" text="Total Price" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblTotal" styleClass="summary-total-value" text="0 MMK" />
                                </HBox>

                            </VBox>

                            <!-- ACTION BUTTONS -->
                            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                <Button fx:id="btnBack" onAction="#clickBack" prefWidth="120.0" styleClass="secondary-button" text="Back" />
                                <Button fx:id="btnContinue" onAction="#clickContinue" prefWidth="180.0" styleClass="gradient-button" text="Continue to Details" />
                            </HBox>
                        </VBox>

                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>