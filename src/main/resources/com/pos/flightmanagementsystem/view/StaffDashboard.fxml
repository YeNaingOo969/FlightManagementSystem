<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.StackedBarChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="775.0" prefWidth="1280.0" styleClass="super-dashboard-root" stylesheets="@/com/pos/flightmanagementsystem/Style/staffDashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <VBox fx:id="contentArea" spacing="24.0" styleClass="super-content" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="super-topbar">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="super-page-kicker" text="Welcome back," />
                        <Label styleClass="super-page-title" text="Label" />
                        <Label styleClass="super-page-subtitle" text="Label" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="20.0" styleClass="super-metrics-row">
               <children>
                  <StackPane styleClass="super-metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" StackPane.alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="card-label-title" text="Label" />
                              <Label styleClass="card-value" text="Label" />
                              <Label styleClass="card-label-status" text="Label" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <StackPane styleClass="super-metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" StackPane.alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="card-label-title" text="Label" />
                              <Label styleClass="card-label-value" text="Label" />
                              <Label styleClass="card-label-status" text="Label" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <StackPane styleClass="super-metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" StackPane.alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="card-label-title" text="Label" />
                              <Label styleClass="card-label-value" text="Label" />
                              <Label styleClass="card-label-status" text="Label" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <StackPane styleClass="super-metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" StackPane.alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="card-label-title" text="Label" />
                              <Label styleClass="card-label-value" text="Label" />
                              <Label styleClass="card-label-status" text="Label" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
               </children>
            </HBox>
            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="16.0" styleClass="super-panel" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="super-section-title" text="Recent Booking" />
                                    <Label styleClass="super-section-subtitle" text="Label" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <TableView prefHeight="360.0" styleClass="super-table" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn prefWidth="180.0" text="Booking ID" />
                              <TableColumn prefWidth="160.0" text="Route" />
                              <TableColumn prefWidth="160.0" text="Date" />
                              <TableColumn prefWidth="420.0" text="Schedule" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <placeholder>
                              <Label text="No recent activity yet" />
                           </placeholder>
                        </TableView>
                     </children>
                  </VBox>
                  <VBox prefWidth="310.0" spacing="18.0" styleClass="charts-container">
                     <children>
                        <Label styleClass="chart-panel-title" text="Booking Overview" />
                        <Region VBox.vgrow="ALWAYS" />
                        <StackedBarChart>
                           <xAxis>
                              <CategoryAxis side="BOTTOM" />
                           </xAxis>
                           <yAxis>
                              <NumberAxis side="LEFT" />
                           </yAxis>
                        </StackedBarChart>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>