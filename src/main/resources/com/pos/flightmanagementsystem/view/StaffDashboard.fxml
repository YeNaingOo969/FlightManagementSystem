<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- 🌟 အလယ်က Content သာ Scroll ဖြစ်ရန် ScrollPane ဖြင့် အုပ်ပေးထားပါသည် 🌟 -->
<ScrollPane fitToWidth="true" styleClass="dashboard-scroll-pane" stylesheets="@/com/pos/flightmanagementsystem/Style/StaffDashboardDark.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.StaffDashboardController">
   <content>
      <VBox fx:id="contentArea" spacing="24.0" styleClass="super-content" minWidth="0">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>

            <!-- 🌟 TOPBAR 🌟 -->
            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="super-topbar" minWidth="0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="super-page-kicker" text="STAFF WORKSPACE" />
                        <Label styleClass="super-page-title" text="Daily Operations &amp; Sales" />
                        <Label styleClass="super-page-subtitle" text="Monitor your sales performance, today's flights, and booking statuses." />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_RIGHT" spacing="8.0">
                     <children>
                        <Label styleClass="super-status-pill" text="● Desk Active" />
                        <Label fx:id="lblCurrentDate" styleClass="super-time-label" text="Today" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- 🌟 METRICS ROW (4 Cards) 🌟 -->
            <HBox spacing="20.0" styleClass="super-metrics-row" minWidth="0">
               <children>
                  <!-- 1. My Sales -->
                  <VBox styleClass="super-metric-card-blue" HBox.hgrow="ALWAYS" minWidth="0">
                     <Label styleClass="super-metric-label" text="My Sales (This Month)" />
                     <Label fx:id="lblMySales" styleClass="super-metric-value" text="0 MMK" />
                     <Label styleClass="super-metric-note" text="Total revenue generated" />
                  </VBox>

                  <!-- 2. My Bookings -->
                  <VBox styleClass="super-metric-card-green" HBox.hgrow="ALWAYS" minWidth="0">
                     <Label styleClass="super-metric-label" text="My Bookings (This Month)" />
                     <Label fx:id="lblMyBookings" styleClass="super-metric-value" text="0" />
                     <Label styleClass="super-metric-note" text="Tickets sold &amp; confirmed" />
                  </VBox>

                  <!-- 3. Today's Flights -->
                  <VBox styleClass="super-metric-card-purple" HBox.hgrow="ALWAYS" minWidth="0">
                     <Label styleClass="super-metric-label" text="Today's Flights" />
                     <Label fx:id="lblTodayFlights" styleClass="super-metric-value" text="0" />
                     <Label styleClass="super-metric-note" text="Scheduled for departure today" />
                  </VBox>

                  <!-- 4. Pending Cancel Requests -->
                  <VBox styleClass="super-metric-card-red" HBox.hgrow="ALWAYS" minWidth="0">
                     <Label styleClass="super-metric-label" text="Pending Cancel Requests" />
                     <Label fx:id="lblPendingCancels" styleClass="super-metric-value" text="0" />
                     <Label styleClass="super-metric-note" text="Awaiting admin approval" />
                  </VBox>
               </children>
            </HBox>

            <!-- 🌟 BOTTOM SECTION (2 Tables Side-by-Side) 🌟 -->
            <HBox spacing="18.0" VBox.vgrow="ALWAYS" minWidth="0">
               <children>
                  <!-- Left Table: Live Flight Board -->
                  <VBox spacing="16.0" styleClass="super-panel" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" prefWidth="500.0" minWidth="0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                              <Label styleClass="super-section-title" text="Live Flight Board" />
                              <Label styleClass="super-section-subtitle" text="Flights scheduled for today" />
                           </VBox>
                        </HBox>
                        <TableView fx:id="flightBoardTable" styleClass="super-table" VBox.vgrow="ALWAYS" minWidth="0">
                           <columns>
                              <TableColumn fx:id="colFlightNo" prefWidth="100.0" text="Flight No" />
                              <TableColumn fx:id="colFlightRoute" prefWidth="180.0" text="Route" />
                              <TableColumn fx:id="colFlightTime" prefWidth="120.0" text="Departure" />
                              <TableColumn fx:id="colFlightStatus" prefWidth="100.0" text="Status" />
                           </columns>
                           <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                           <placeholder><Label text="No flights scheduled for today" /></placeholder>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- Right Table: My Recent Bookings -->
                  <VBox spacing="16.0" styleClass="super-panel" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" prefWidth="500.0" minWidth="0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                              <Label styleClass="super-section-title" text="My Recent Bookings" />
                              <Label styleClass="super-section-subtitle" text="Your latest ticketing actions" />
                           </VBox>
                        </HBox>
                        <TableView fx:id="recentBookingsTable" styleClass="super-table" VBox.vgrow="ALWAYS" minWidth="0">
                           <columns>
                              <TableColumn fx:id="colBookingPNR" prefWidth="100.0" text="PNR" />
                              <TableColumn fx:id="colBookingPrice" prefWidth="130.0" text="Price (MMK)" />
                              <TableColumn fx:id="colBookingDate" prefWidth="140.0" text="Booking Date" />
                              <TableColumn fx:id="colBookingStatus" prefWidth="130.0" text="Status" />
                           </columns>
                           <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                           <placeholder><Label text="No recent bookings found" /></placeholder>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>

         </children>
      </VBox>
   </content>
</ScrollPane>