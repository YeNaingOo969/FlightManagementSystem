<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="rootPane" styleClass="super-content" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminSystemToolsDark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.SuperAdminSystemToolController">
   <children>

      <VBox fx:id="contentArea" spacing="25.0" styleClass="main-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="15.0">
         <children>

            <!-- 1. TITLE CARD -->
            <VBox maxWidth="1.7976931348623157E308" styleClass="title-card">
               <children>
                  <Label styleClass="header-title" text="System Tools" />
                  <Label styleClass="header-subtitle" text="Manage system database backups and configurations" />
               </children>
            </VBox>

            <!-- 2. MAIN CONTENT CARD -->
            <VBox maxWidth="1.7976931348623157E308" spacing="25.0" styleClass="tool-card" VBox.vgrow="ALWAYS">
               <children>

                  <!-- Backup Database Section -->
                  <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" styleClass="sub-header-box">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="section-title" text="Backup Database" />
                              <Label styleClass="normal-text" text="Last Backup: " />
                           </children>
                        </VBox>
                        <Button fx:id="btnBackupNow" mnemonicParsing="false" onAction="#handleBackupNow" prefHeight="40.0" prefWidth="140.0" styleClass="button-backup-now" text="Backup Now" />
                     </children>
                  </HBox>

                  <!-- Export SQL Section -->
                  <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" styleClass="export-box">
                     <children>
                        <Label styleClass="normal-text" text="Backup your system database and export it as a SQL file to secure your data." HBox.hgrow="ALWAYS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnExportSql" mnemonicParsing="false" onAction="#handleExportSql" prefHeight="40.0" prefWidth="140.0" styleClass="button-export-sql" text="Export SQL" />
                     </children>
                  </HBox>

                  <!-- Backup History Table Section -->
                  <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label styleClass="section-title" text="Backup History" />
                        <TableView fx:id="tvBackupHistory" prefHeight="450.0" styleClass="table-view" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colDate" prefWidth="75.0" text="Date" />
                              <TableColumn fx:id="colFileName" prefWidth="75.0" text="File Name" />
                              <TableColumn fx:id="colSize" prefWidth="75.0" text="Size" />
                              <TableColumn fx:id="colAction" prefWidth="75.0" text="Action" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>

               </children>
            </VBox>
         </children>
      </VBox>

      <!-- 🌟 Toast Notification 🌟 -->
      <HBox fx:id="notificationToast" alignment="CENTER_LEFT" prefWidth="420.0" spacing="15.0" styleClass="toast-notification" visible="false" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0">
         <children>
            <StackPane fx:id="toastIconBg" styleClass="toast-icon-bg">
               <children>
                  <SVGPath fx:id="toastIconPath" content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" styleClass="toast-icon-glyph" />
               </children>
            </StackPane>

            <VBox alignment="CENTER_LEFT" spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblToastTitle" styleClass="toast-title" text="Success!" />
                  <Label fx:id="lblToastMessage" styleClass="toast-message" text="Action completed." wrapText="true" />
               </children>
            </VBox>

            <VBox alignment="TOP_RIGHT">
               <children>
                  <Button mnemonicParsing="false" onAction="#closeNotification" styleClass="toast-close-btn">
                     <graphic>
                        <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" styleClass="toast-close-icon" />
                     </graphic>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>

   </children>
</AnchorPane>