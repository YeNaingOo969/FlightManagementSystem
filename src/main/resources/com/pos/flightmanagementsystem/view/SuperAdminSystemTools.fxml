<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="rootPane" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminSystemTools.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.SuperAdminSystemToolController">
   <children>

      <!-- Main Content -->
      <VBox fx:id="contentArea" spacing="25.0" style="-fx-background-color: transparent; -fx-padding: 30;" styleClass="main-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <!-- 1. TITLE CARD -->
            <VBox maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
               <children>
                  <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="System Tools" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #0ea5e9;" text="Manage system database backups and configurations" />
               </children>
            </VBox>

            <!-- 2. MAIN CONTENT CARD -->
            <VBox maxWidth="1.7976931348623157E308" spacing="25.0" styleClass="tool-card" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
               <children>

                  <!-- Backup Database Section -->
                  <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" styleClass="sub-header-box">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="section-title" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Backup Database" />
                              <Label style="-fx-text-fill: #64748b;" text="Last Backup: " />
                           </children>
                        </VBox>
                        <Button fx:id="btnBackupNow" mnemonicParsing="false" onAction="#handleBackupNow" prefHeight="40.0" prefWidth="140.0" styleClass="button-backup-now" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Backup Now" />
                     </children>
                  </HBox>

                  <!-- Export SQL Section -->
                  <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                     <children>
                        <Label style="-fx-text-fill: #64748b;" text="Backup your system database and export it as a SQL file to secure your data." HBox.hgrow="ALWAYS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnExportSql" mnemonicParsing="false" onAction="#handleExportSql" prefHeight="40.0" prefWidth="140.0" styleClass="button-export-sql" style="-fx-background-color: #d1fae5; -fx-text-fill: #059669; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Export SQL" />
                     </children>
                  </HBox>

                  <!-- Backup History Table Section -->
                  <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label styleClass="section-title" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Backup History" />
                        <TableView fx:id="tvBackupHistory" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colDate" prefWidth="75.0" text="Date" />
                              <TableColumn fx:id="colFileName" prefWidth="75.0" text="File Name" />
                              <TableColumn fx:id="colSize" prefWidth="75.0" text="Size" />
                              <TableColumn fx:id="colAction" prefWidth="75.0" text="Action" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>

               </children>
            </VBox>
         </children>
      </VBox>

      <!-- 🌟 Toast Notification -->
      <HBox fx:id="notificationToast" alignment="TOP_LEFT" prefWidth="420.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 5);" visible="false" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0">
         <padding>
            <Insets bottom="16.0" left="20.0" right="12.0" top="16.0" />
         </padding>
         <children>
            <StackPane fx:id="toastIconBg" maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0" style="-fx-background-color: #10b981; -fx-background-radius: 50%;">
               <children>
                  <SVGPath fx:id="toastIconPath" content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="white" />
               </children>
               <HBox.margin>
                  <Insets top="2.0" />
               </HBox.margin>
            </StackPane>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblToastTitle" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Success!" />
                  <Label fx:id="lblToastMessage" style="-fx-font-size: 13px; -fx-text-fill: #4b5563; -fx-line-spacing: 2px;" text="Action completed." wrapText="true" />
               </children>
               <HBox.margin>
                  <Insets top="1.0" />
               </HBox.margin>
            </VBox>
            <Button mnemonicParsing="false" onAction="#closeNotification" style="-fx-background-color: transparent; -fx-cursor: hand;">
               <graphic>
                  <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="#9ca3af" />
               </graphic>
               <HBox.margin>
                  <Insets top="-4.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>

   </children>
</AnchorPane>