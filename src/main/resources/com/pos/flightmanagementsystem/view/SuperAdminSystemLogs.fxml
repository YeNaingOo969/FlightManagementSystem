<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- 🌟 Inline Styles များအားလုံးကို ဖယ်ရှားပြီး CSS Class များကိုသာ အသုံးပြုထားသည် -->
<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="25.0" style="-fx-padding: 30;" styleClass="super-content" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminSystemLogsDark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <!-- ========================================== -->
      <!-- 1. TITLE CARD -->
      <!-- ========================================== -->
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="15.0" styleClass="super-topbar">
         <children>
            <StackPane styleClass="super-metric-icon">
               <children>
                  <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2zm-4 4H7v-2h6v2z" styleClass="super-metric-icon-glyph" />
               </children>
            </StackPane>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="page-title" text="System Logs" />
                  <Label styleClass="page-subtitle" text="Track and audit system events &amp; user activities" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- ========================================== -->
      <!-- 2. MAIN CONTENT CARD (Search + Table + Button) -->
      <!-- ========================================== -->
      <!-- 🌟 ဒီနေရာမှာ table-card class ကို သုံးလိုက်ပါသည် -->
      <VBox maxWidth="1.7976931348623157E308" spacing="25.0" styleClass="table-card" VBox.vgrow="ALWAYS">
         <children>

            <!-- Search and Filter Bar -->
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="15.0" styleClass="search-container">
               <children>

                  <!-- Search Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" styleClass="search-icon" />
                        <TextField prefHeight="38.0" promptText="Search here" styleClass="search-field" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <!-- Filters & Clear Button -->
                  <HBox alignment="CENTER_RIGHT" spacing="15.0" HBox.hgrow="ALWAYS">
                     <children>
                        <ComboBox prefHeight="38.0" prefWidth="150.0" styleClass="combo-box" />
                        <DatePicker prefHeight="38.0" styleClass="date-picker" />
                        <Region HBox.hgrow="ALWAYS" />

                        <!-- 🌟 Primary Button Class ကိုသာသုံးသည်, Hard Code ကို ဖြုတ်လိုက်သည် -->
                        <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="120.0" styleClass="primary-button" text="Clear" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- Table View -->
            <TableView maxWidth="1.7976931348623157E308" styleClass="super-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn prefWidth="75.0" text="Log ID" />
                  <TableColumn prefWidth="75.0" text="Timestamp" />
                  <TableColumn prefWidth="75.0" text="User" />
                  <TableColumn prefWidth="75.0" text="Action" />
                  <TableColumn prefWidth="75.0" text="Description" />
                  <TableColumn prefWidth="75.0" text="Status" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <!-- Export Button -->
            <HBox alignment="CENTER_LEFT">
               <children>
                  <!-- 🌟 Export Button Class ကိုသာသုံးသည် -->
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="120.0" styleClass="button-export" text="Export" />
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</VBox>