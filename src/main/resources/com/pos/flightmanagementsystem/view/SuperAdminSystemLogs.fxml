<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- 🌟 အဖြူရောင်ဖြစ်စေသော Inline Style များကို ဖယ်ရှားထားပါသည် 🌟 -->
<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="25.0" style="-fx-background-color: transparent; -fx-padding: 30;" styleClass="super-content" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminSystemLogsDark.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <!-- ========================================== -->
      <!-- 1. TITLE CARD (Top Bar) -->
      <!-- ========================================== -->
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="15.0" styleClass="super-topbar">
         <children>
            <StackPane styleClass="super-metric-icon">
               <children>
                  <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2zm-4 4H7v-2h6v2z" styleClass="super-metric-icon-glyph" />
               </children>
            </StackPane>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="page-title" text="System Logs" />
                  <Label styleClass="page-subtitle" text="Track and audit system events &amp; user activities" />
               </children>
            </VBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Role ComboBox -->
            <ComboBox fx:id="cbRoleFilter" prefHeight="38.0" prefWidth="150.0" promptText="Select Role" styleClass="combo-box">
               <items>
                  <FXCollections fx:factory="observableArrayList">
                     <String fx:value="All" />
                     <String fx:value="Admin" />
                     <String fx:value="Staff" />
                  </FXCollections>
               </items>
            </ComboBox>

            <!-- Date Picker -->
            <DatePicker fx:id="dpDateFilter" prefHeight="38.0" styleClass="date-picker" />
         </children>
      </HBox>

      <!-- ========================================== -->
      <!-- 2. MAIN CONTENT CARD (Table Area) -->
      <!-- ========================================== -->
      <VBox maxWidth="1.7976931348623157E308" spacing="25.0" styleClass="super-panel" VBox.vgrow="ALWAYS">
         <children>
            <!-- Table View -->
            <TableView fx:id="logsTable" maxWidth="1.7976931348623157E308" styleClass="super-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colLogId" prefWidth="75.0" text="Log ID" />
                  <TableColumn fx:id="colUser" prefWidth="120.0" text="User" />
                  <TableColumn fx:id="colRole" prefWidth="100.0" text="Role" />
                  <TableColumn fx:id="colAction" prefWidth="148.0" text="Action" />
                  <TableColumn fx:id="colTimestamp" prefWidth="137.0" text="Timestamp" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <!-- Placeholder ရှင်းလင်းရန် -->
               <placeholder>
                  <Label text="No logs available" />
               </placeholder>
            </TableView>
         </children>
      </VBox>

   </children>
</VBox>