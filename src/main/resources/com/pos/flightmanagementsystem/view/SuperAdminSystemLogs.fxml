<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- 🌟 အပြင်ဘက် Container က ဘာပဲဖြစ်ဖြစ် နေရာအပြည့်ယူအောင် AnchorPane, HBox.hgrow, VBox.vgrow များကို ထည့်သွင်းထားပါသည် -->

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="25.0" style="-fx-background-color: transparent; -fx-padding: 30;" styleClass="super-content" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminSystemLogs.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.SystemLogsController">
   <children>

      <!-- ========================================== -->
      <!-- 1. TITLE CARD -->
      <!-- ========================================== -->
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
         <children>
            <StackPane styleClass="super-metric-icon">
               <children>
                  <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2zm-4 4H7v-2h6v2z" />
               </children>
            </StackPane>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" styleClass="page-title" text="System Logs" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #0ea5e9;" styleClass="page-subtitle" text="Track and audit system events &amp; user activities" />
               </children>
            </VBox>

            <!-- 🌟 Title နဲ့ Filters ကြားမှာ နေရာလွတ်ဖန်တီးပေးမယ့် Spacer -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Role ComboBox -->
            <ComboBox fx:id="cbRoleFilter" prefHeight="38.0" prefWidth="150.0" promptText="Select Role" styleClass="combo-box">
               <items>
                  <FXCollections fx:factory="observableArrayList">
                     <String fx:value="All" />
                     <String fx:value="Admin" />
                     <String fx:value="Staff" />
                  </FXCollections>
               </items>
            </ComboBox>

            <!-- Date Picker -->
            <DatePicker fx:id="dpDateFilter" prefHeight="38.0" styleClass="date-picker" />
         </children>
      </HBox>

      <!-- ========================================== -->
      <!-- 2. MAIN CONTENT CARD (Filters + Table) -->
      <!-- ========================================== -->
      <VBox maxWidth="1.7976931348623157E308" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
         <children>

            <!-- Table View -->
            <TableView fx:id="logsTable" maxWidth="1.7976931348623157E308" styleClass="super-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colLogId" prefWidth="75.0" text="Log ID" />
                  <TableColumn fx:id="colUser" prefWidth="120.0" text="User" />
                  <TableColumn fx:id="colRole" prefWidth="100.0" text="Role" />
                  <TableColumn fx:id="colAction" prefWidth="148.0" text="Action" />
                  <TableColumn fx:id="colTimestamp" prefWidth="137.0" text="Timestamp" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

         </children>
      </VBox>

   </children>
</VBox>
