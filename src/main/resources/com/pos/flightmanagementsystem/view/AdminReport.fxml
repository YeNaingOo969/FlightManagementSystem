<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- သင့်ရဲ့ Package Name အတိုင်း fx:controller ကို ပြင်ပေးရန် လိုအပ်နိုင်ပါသည် -->
<StackPane fx:id="rootStackPane" stylesheets="@/com/pos/flightmanagementsystem/Style/AdminViewSalesDetailDark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.AdminViewSalesDetailController">

   <BorderPane prefHeight="816.0" prefWidth="1200.0" styleClass="super-content">
      <center>
         <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
               <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>

            <!-- 🌟 ၁။ Header & Filters Card -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="super-topbar">
               <children>
                  <StackPane styleClass="super-brand-logo">
                     <children>
                        <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" styleClass="super-brand-logo-glyph"/>
                     </children>
                  </StackPane>

                  <VBox alignment="CENTER_LEFT" spacing="2.0">
                     <children>
                        <Label styleClass="super-page-title" text="Report &amp; Executive Analytics" />
                        <Label styleClass="super-section-subtitle" text="Detailed operational performance and staff revenue metrics." />
                     </children>
                  </VBox>

                  <Region HBox.hgrow="ALWAYS" />

                  <!-- Date Filters -->
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="filter-label" text="From Date" />
                              <DatePicker fx:id="dpFromDate" promptText="Start Date" styleClass="super-date-picker" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="filter-label" text="To Date" />
                              <DatePicker fx:id="dpToDate" promptText="End Date" styleClass="super-date-picker" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Export Button -->
                  <Button fx:id="btnExport" mnemonicParsing="false" styleClass="btn-primary" text="Export Report">
                     <graphic>
                        <SVGPath content="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" styleClass="export-icon" />
                     </graphic>
                  </Button>
               </children>
            </HBox>

            <!-- 🌟 ၂။ KPI Summary Cards (4 ခု) -->
            <HBox spacing="20.0" VBox.vgrow="NEVER">
               <children>
                  <!-- Total Revenue -->
                  <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="kpi-title" text="Total Revenue" />
                        <Label fx:id="lblTotalRevenue" styleClass="kpi-value" text="\$0.00" />
                        <Label fx:id="lblRevenuePercent" styleClass="kpi-status-up" text="" />
                     </children>
                  </VBox>
                  <!-- Total Tickets Sold -->
                  <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="kpi-title" text="Total Tickets Sold" />
                        <Label fx:id="lblTotalTickets" styleClass="kpi-value" text="0" />
                        <Label fx:id="lblTicketsPercent" styleClass="kpi-status-up" text="" />
                     </children>
                  </VBox>
                  <!-- Top Flight -->
                  <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="kpi-title" text="Top Selling Flight" />
                        <Label fx:id="lblTopFlight" styleClass="kpi-value" text="N/A" />
                        <Label styleClass="kpi-status-neutral" text="Consistent Performer" />
                     </children>
                  </VBox>
                  <!-- Top Staff -->
                  <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="kpi-title" text="Top Performing Staff" />
                        <Label fx:id="lblTopStaff" styleClass="kpi-value" text="N/A" />
                        <Label fx:id="lblTopStaffRevenue" styleClass="kpi-status-up" text="\$0.00 generated" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- 🌟 ၃။ Detailed Breakdown Tables (Flight & Staff Side-by-Side) (Charts ဖယ်ထားပြီးဖြစ်သည်) -->
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Flight Sales Table -->
                  <VBox spacing="10.0" styleClass="super-topbar" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="super-section-title" text="Flight Sales Breakdown" />
                        <TableView fx:id="flightSalesTable" styleClass="super-table" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colFlightNo" prefWidth="90.0" text="Flight No." />
                              <TableColumn fx:id="colRoute" prefWidth="120.0" text="Route" />
                              <TableColumn fx:id="colFlightTickets" prefWidth="100.0" text="Tickets Sold" />
                              <TableColumn fx:id="colFlightRevenue" prefWidth="120.0" text="Total Revenue" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- Staff Sales Table -->
                  <VBox spacing="10.0" styleClass="super-topbar" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="super-section-title" text="Staff Sales Breakdown" />
                        <TableView fx:id="staffSalesTable" styleClass="super-table" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colStaffName" prefWidth="120.0" text="Staff Name" />
                              <TableColumn fx:id="colStaffRole" prefWidth="90.0" text="Role" />
                              <TableColumn fx:id="colStaffTickets" prefWidth="100.0" text="Tickets Sold" />
                              <TableColumn fx:id="colStaffRevenue" prefWidth="120.0" text="Revenue Gen." />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>

         </VBox>
      </center>
   </BorderPane>
</StackPane>