<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:controller="com.pos.flightmanagementsystem.controller.SuperAdminCreateUserController" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="dialog-card" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminCreateUser.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Height ကို 580 ကနေ 480 သို့ လျှော့ချထားပါတယ် -->
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="450.0" spacing="20.0" styleClass="form-section">
         <children>
            <!-- Title Section -->
            <HBox alignment="CENTER" prefHeight="40.0" prefWidth="450.0" spacing="15.0">
               <children>
                  <StackPane styleClass="profile-section-icon">
                     <children>
                        <SVGPath content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" styleClass="profile-section-icon-glyph" />
                     </children>
                  </StackPane>
                  <Label styleClass="form-title" text="Add New Staff Account" />
               </children>
            </HBox>

            <!-- Form Fields Section -->
            <VBox prefHeight="262.0" prefWidth="450.0" spacing="5.0" styleClass="form-section">
               <children>
                  <VBox prefHeight="70.0" prefWidth="450.0">
                     <children>
                        <Label styleClass="field-label" text="Username" />
                        <TextField promptText="Enter username" styleClass="text-field" />
                     </children>
                  </VBox>
                  <VBox prefHeight="70.0" prefWidth="450.0">
                     <children>
                        <Label styleClass="field-label" text="Email" />
                        <TextField promptText="example@gmail.com" styleClass="text-field" />
                     </children>
                  </VBox>
                  <VBox prefHeight="70.0" prefWidth="450.0">
                     <children>
                        <Label styleClass="field-label" text="Password" />
                        <PasswordField styleClass="password-field" />
                     </children>
                  </VBox>
                  <VBox prefHeight="70.0" prefWidth="450.0">
                     <children>
                        <Label styleClass="field-label" text="Position" />
                        <ComboBox prefWidth="450.0" promptText="Select Role" styleClass="combo-box" />
                     </children>
                  </VBox>

                  <!-- Buttons Section -->
                  <HBox alignment="CENTER" prefHeight="60.0" prefWidth="450.0">
                     <children>
                        <!-- Cancel Button အတွက် fx:id နှင့် onAction ထည့်သွင်းထားပါသည် -->
                        <Button fx:id="btnCancel" onAction="#clickCancel" minHeight="39.0" minWidth="120.0" mnemonicParsing="false" styleClass="button-cancel" text="Cancel" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minHeight="39.0" minWidth="120.0" mnemonicParsing="false" styleClass="button-save" text="Save" />
                     </children>
                     <VBox.margin>
                        <Insets top="15.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
         <StackPane.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </StackPane.margin>
      </VBox>
   </children>
</StackPane>