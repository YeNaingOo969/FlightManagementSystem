<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane" stylesheets="@/com/pos/flightmanagementsystem/Style/AdminCityLight.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.AdminCityController">
    <children>
        <AnchorPane prefHeight="731.0" prefWidth="1031.0" styleClass="super-content">
            <children>
                <VBox spacing="20.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
                    <children>
                        <!-- Header Section -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="super-topbar">
                            <children>
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="super-page-title" text="City Management" />
                                        <Label styleClass="super-section-subtitle" text="Manage and view all available departure and arrival cities." />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />

                                <!-- Search Bar -->
                                <TextField fx:id="txtSearchCity" prefWidth="250.0" promptText="Search city name or code..." styleClass="search-field" />

                                <!-- Add New City Button -->
                                <Button fx:id="btnAddCity" mnemonicParsing="false" onAction="#clickAddCity" styleClass="btn-primary" text="+ Add New City" />
                            </children>
                        </HBox>

                        <!-- Table Section -->
                        <!-- 🌟 ပြင်ဆင်ချက်: super-topbar အစား super-panel သို့ ပြောင်းထားပါသည် 🌟 -->
                        <VBox spacing="20.0" styleClass="super-panel" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- 🌟 ပြင်ဆင်ချက်: styleClass="super-table" ထည့်သွင်းထားပါသည် 🌟 -->
                                <TableView fx:id="tableCities" styleClass="super-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colCityId" prefWidth="75.0" text="City ID" />
                                        <TableColumn fx:id="colCityCode" prefWidth="75.0" text="City Code" />
                                        <TableColumn fx:id="colCityName" prefWidth="75.0" text="City Name" />
                                        <TableColumn fx:id="colCountry" prefWidth="75.0" text="Country" />
                                        <TableColumn fx:id="colCreatedAt" prefWidth="120.0" text="Created At" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>