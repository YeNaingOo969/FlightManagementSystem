<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="800" prefWidth="1200" stylesheets="@../CssFile/booking.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Main Content -->
    <center>
        <VBox spacing="10.0">
            <padding><Insets bottom="20" left="30" right="30" top="20" /></padding>
            
            <!-- Header Section with Search -->
            <HBox alignment="CENTER_LEFT" spacing="5.0">
            <StackPane prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" styleClass="super-brand-logo">
               <children>
                  <SVGPath content="M22 10V6c0-1.11-.9-2-2-2H4c-1.1 0-1.99.89-1.99 2v4c1.1 0 1.99.9 1.99 2s-.89 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z" />
               </children>
            </StackPane>
                <Label styleClass="page-title" text="Booking Management" HBox.hgrow="ALWAYS" />
                <Region HBox.hgrow="ALWAYS" />
            <HBox prefHeight="100.0" prefWidth="200.0" styleClass="search-box-container" HBox.hgrow="ALWAYS">
               <children>
                  <StackPane prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" styleClass="super-brand-logo">
                     <children>
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" styleClass="svg-path" />
                     </children>
                  </StackPane>
                  <TextField promptText="Search booking..." styleClass="text-field" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            </HBox>
         <VBox VBox.vgrow="ALWAYS">
            <children>
      
                  <!-- Booking Table -->
                  <TableView styleClass="super-table" VBox.vgrow="ALWAYS">
                      <columns>
                          <TableColumn prefWidth="100" text="Booking ID" />
                          <TableColumn prefWidth="150" text="Customer" />
                          <TableColumn prefWidth="100" text="Flight" />
                          <TableColumn prefWidth="120" text="Date" />
                          <TableColumn prefWidth="100" text="Status" />
                          <TableColumn prefWidth="100" text="Action" />
                      </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                  </TableView>
            </children>
         </VBox>
         <HBox alignment="BASELINE_LEFT" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <children>
               <Label prefHeight="15.0" styleClass="form-label" text="Showing 1-10 of 150 entries" HBox.hgrow="ALWAYS" />
               <Region prefHeight="100.0" prefWidth="838.0" />
               <Pagination maxPageIndicatorCount="5" prefHeight="200.0" HBox.hgrow="ALWAYS" />
            </children>
         </HBox>
        </VBox>
    </center>
</BorderPane>
