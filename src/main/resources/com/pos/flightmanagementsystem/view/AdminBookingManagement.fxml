<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="rootStackPane" stylesheets="@/com/pos/flightmanagementsystem/Style/AdminBookingLight.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.AdminBookingManagementController">

    <BorderPane prefHeight="800" prefWidth="1200" styleClass="super-content">
        <center>
            <VBox spacing="25.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                </padding>

                <!-- Header & Search Card -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="super-topbar">
                    <children>
                        <StackPane styleClass="super-brand-logo">
                            <children>
                                <SVGPath content="M22 10V6c0-1.11-.9-2-2-2H4c-1.1 0-1.99.89-1.99 2v4c1.1 0 1.99.9 1.99 2s-.89 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z" styleClass="super-brand-logo-glyph" />
                            </children>
                        </StackPane>

                        <VBox alignment="CENTER_LEFT" spacing="4.0">
                            <children>
                                <Label styleClass="super-page-title" text="Booking Management" />
                                <Label styleClass="super-section-subtitle" text="View and manage all customer flight bookings." />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER_LEFT" maxWidth="300.0" prefWidth="300.0" spacing="8.0" styleClass="search-field">
                            <children>
                                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" styleClass="search-icon" />
                                <TextField promptText="Search booking..." styleClass="search-input" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Table & Pagination Card -->
                <VBox spacing="20.0" styleClass="super-panel" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="bookingTable" styleClass="super-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBookingId" prefWidth="120" text="Booking ID" />
                                <TableColumn fx:id="colCustomer" prefWidth="180" text="Customer" />
                                <TableColumn fx:id="colFlight" prefWidth="150" text="Flight" />
                                <TableColumn fx:id="colDate" prefWidth="120" text="Date" />
                                <TableColumn fx:id="colStatus" prefWidth="244.0" text="Status" />
                                <TableColumn fx:id="colAction" prefWidth="139.0" styleClass="action-column" text="Action" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="20.0" VBox.vgrow="NEVER">
                            <children>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="pagination-label" text="Showing 1-10 of 150 entries" />
                                <Pagination maxPageIndicatorCount="5" prefHeight="40.0" styleClass="super-pagination" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </VBox>
        </center>
    </BorderPane>
</StackPane>