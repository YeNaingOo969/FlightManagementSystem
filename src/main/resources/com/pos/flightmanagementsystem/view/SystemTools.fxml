<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Root VBox တွင် Size Limit များကို ဖြုတ်ပြီး အပြည့်ကျယ်စေရန် ပြင်ဆင်ထားသည် -->
<VBox fx:id="contentArea" spacing="25.0" style="-fx-background-color: transparent; -fx-padding: 30;" styleClass="main-container" stylesheets="@/com/pos/flightmanagementsystem/Style/systemTools.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <!-- ========================================== -->
      <!-- 1. NEW TITLE CARD (Account Management ပုံစံ) -->
      <!-- ========================================== -->
      <VBox maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
         <children>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="System Tools" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #0ea5e9;" text="Manage system database backups and configurations" />
         </children>
      </VBox>

      <!-- ========================================== -->
      <!-- 2. MAIN CONTENT CARD (ပိုကျယ်သွားအောင် ပြင်ထားသည်) -->
      <!-- ========================================== -->
      <VBox maxWidth="1.7976931348623157E308" spacing="25.0" styleClass="tool-card" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
         <children>

            <!-- Backup Database Section -->
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" styleClass="sub-header-box">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="section-title" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Backup Database" />
                        <Label style="-fx-text-fill: #64748b;" text="Last Backup: " />
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="140.0" styleClass="button-backup-now" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Backup Now" />
               </children>
            </HBox>

            <!-- Export SQL Section -->
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
               <children>
                  <Label style="-fx-text-fill: #64748b;" text="Backup your system database and export it as a SQL file to secure your data." HBox.hgrow="ALWAYS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="140.0" styleClass="button-export-sql" style="-fx-background-color: #d1fae5; -fx-text-fill: #059669; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Export SQL" />
               </children>
            </HBox>

            <!-- Backup History Table Section -->
            <VBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="section-title" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Backup History" />
                  <TableView VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn prefWidth="75.0" text="Date" />
                        <TableColumn prefWidth="75.0" text="File Name" />
                        <TableColumn prefWidth="75.0" text="Size" />
                        <TableColumn prefWidth="75.0" text="Action" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>

         </children>
      </VBox>

   </children>
</VBox>