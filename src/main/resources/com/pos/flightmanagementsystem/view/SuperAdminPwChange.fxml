<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminPwCard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.PwChangeController">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox maxHeight="-Infinity" maxWidth="520.0" prefWidth="520.0" spacing="22.0" styleClass="password-card">
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>
               <children>
                  <!-- Header Section -->
                  <HBox alignment="CENTER_LEFT" spacing="18.0">
                     <children>
                        <StackPane styleClass="icon-circle-bg">
                           <children>
                              <SVGPath content="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5zm-3 5a3 3 0 0 1 6 0v3H9V7zm3 9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z" />
                           </children>
                           <padding>
                              <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                           </padding>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <Label styleClass="header-title" text="Change Password" />
                              <Label styleClass="header-subtitle" text="Update password for enhanced account security." wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <Separator styleClass="line" />

                  <!-- Status Label -->
                  <Label fx:id="lblPwdStatus" style="-fx-font-size: 13px;" text="" wrapText="true" />

                  <!-- ========================================== -->
                  <!-- State 1: Current Password -->
                  <!-- ========================================== -->
                  <VBox fx:id="sectionCurrentPwd" spacing="10.0">
                     <children>
                        <Label styleClass="field-label" text="Current Password" />
                        <StackPane alignment="CENTER_RIGHT">
                           <children>
                              <TextField fx:id="txtCurrentPwdVisible" prefHeight="48.0" styleClass="password-field-modern" visible="false" />
                              <PasswordField fx:id="txtCurrentPwd" prefHeight="48.0" styleClass="password-field-modern" />
                              <Button mnemonicParsing="false" onAction="#toggleCurrentPwd" style="-fx-background-color: transparent; -fx-cursor: hand;">
                                 <graphic>
                                    <SVGPath fx:id="eyeIconCurrent" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" fill="#9ca3af" />
                                 </graphic>
                                 <StackPane.margin>
                                    <Insets right="8.0" />
                                 </StackPane.margin>
                              </Button>
                           </children>
                        </StackPane>
                        <Hyperlink onAction="#showEmailSection" styleClass="clear-link-modern" text="Try another way?" />
                        <HBox alignment="CENTER_RIGHT" spacing="16.0" styleClass="button-row">
                           <VBox.margin><Insets top="12.0" /></VBox.margin>
                           <children>
                              <Button mnemonicParsing="false" onAction="#hidePasswordView" prefHeight="44.0" prefWidth="130.0" styleClass="btn-secondary-modern" text="Cancel" />
                              <Button mnemonicParsing="false" onAction="#verifyCurrentPassword" prefHeight="44.0" prefWidth="160.0" styleClass="btn-primary-modern" text="Confirm" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- ========================================== -->
                  <!-- State 2: Email -->
                  <!-- ========================================== -->
                  <VBox fx:id="sectionEmail" managed="false" spacing="10.0" visible="false">
                     <children>
                        <Label styleClass="field-label" text="Enter Registered Email" />
                        <TextField fx:id="txtEmailReset" prefHeight="48.0" promptText="example@email.com" styleClass="password-field-modern" />
                        <HBox alignment="CENTER_RIGHT" spacing="16.0" styleClass="button-row">
                           <VBox.margin><Insets top="12.0" /></VBox.margin>
                           <children>
                              <Button mnemonicParsing="false" onAction="#showCurrentPwdSection" prefHeight="44.0" prefWidth="130.0" styleClass="btn-secondary-modern" text="Back" />
                              <Button fx:id="btnSendOTP" mnemonicParsing="false" onAction="#sendOTP" prefHeight="44.0" prefWidth="160.0" styleClass="btn-primary-modern" text="Send OTP" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- ========================================== -->
                  <!-- State 3: OTP -->
                  <!-- ========================================== -->
                  <VBox fx:id="sectionOTP" managed="false" spacing="15.0" visible="false">
                     <children>
                        <Label styleClass="field-label" text="Enter 6-digit OTP Code" />
                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <TextField fx:id="otp1" alignment="CENTER" prefHeight="50.0" prefWidth="50.0" styleClass="password-field-modern" />
                              <TextField fx:id="otp2" alignment="CENTER" prefHeight="50.0" prefWidth="50.0" styleClass="password-field-modern" />
                              <TextField fx:id="otp3" alignment="CENTER" prefHeight="50.0" prefWidth="50.0" styleClass="password-field-modern" />
                              <TextField fx:id="otp4" alignment="CENTER" prefHeight="50.0" prefWidth="50.0" styleClass="password-field-modern" />
                              <TextField fx:id="otp5" alignment="CENTER" prefHeight="50.0" prefWidth="50.0" styleClass="password-field-modern" />
                              <TextField fx:id="otp6" alignment="CENTER" prefHeight="50.0" prefWidth="50.0" styleClass="password-field-modern" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="16.0" styleClass="button-row">
                           <VBox.margin><Insets top="12.0" /></VBox.margin>
                           <children>
                              <Button mnemonicParsing="false" onAction="#showEmailSection" prefHeight="44.0" prefWidth="130.0" styleClass="btn-secondary-modern" text="Cancel" />
                              <Button fx:id="btnVerifyOTP" mnemonicParsing="false" onAction="#verifyOTP" prefHeight="44.0" prefWidth="160.0" styleClass="btn-primary-modern" text="Verify" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- ========================================== -->
                  <!-- State 4: New Password -->
                  <!-- ========================================== -->
                  <VBox fx:id="sectionNewPwd" managed="false" spacing="10.0" visible="false">
                     <children>
                        <Label styleClass="field-label" text="New Password" />
                        <StackPane alignment="CENTER_RIGHT">
                           <children>
                              <TextField fx:id="txtNewPwdVisible" prefHeight="48.0" styleClass="password-field-modern" visible="false" />
                              <PasswordField fx:id="txtNewPwd" prefHeight="48.0" styleClass="password-field-modern" />
                              <Button mnemonicParsing="false" onAction="#toggleNewPwd" style="-fx-background-color: transparent; -fx-cursor: hand;">
                                 <graphic>
                                    <SVGPath fx:id="eyeIconNew" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" fill="#9ca3af" />
                                 </graphic>
                                 <StackPane.margin>
                                    <Insets right="8.0" />
                                 </StackPane.margin>
                              </Button>
                           </children>
                        </StackPane>

                        <Label styleClass="field-label" text="Confirm Password">
                           <VBox.margin><Insets top="10.0" /></VBox.margin>
                        </Label>
                        <StackPane alignment="CENTER_RIGHT">
                           <children>
                              <TextField fx:id="txtConfirmPwdVisible" prefHeight="48.0" styleClass="password-field-modern" visible="false" />
                              <PasswordField fx:id="txtConfirmPwd" prefHeight="48.0" styleClass="password-field-modern" />
                              <Button mnemonicParsing="false" onAction="#toggleConfirmPwd" style="-fx-background-color: transparent; -fx-cursor: hand;">
                                 <graphic>
                                    <SVGPath fx:id="eyeIconConfirm" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" fill="#9ca3af" />
                                 </graphic>
                                 <StackPane.margin>
                                    <Insets right="8.0" />
                                 </StackPane.margin>
                              </Button>
                           </children>
                        </StackPane>

                        <HBox alignment="CENTER_RIGHT" spacing="16.0" styleClass="button-row">
                           <VBox.margin><Insets top="12.0" /></VBox.margin>
                           <children>
                              <Button mnemonicParsing="false" onAction="#hidePasswordView" prefHeight="44.0" prefWidth="130.0" styleClass="btn-secondary-modern" text="Discard" />
                              <Button mnemonicParsing="false" onAction="#applyNewPassword" prefHeight="44.0" prefWidth="160.0" styleClass="btn-primary-modern" text="Apply Changes" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>