<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- ဒီ VBox က စောနက BorderPane ရဲ့ Center ထဲကို ဝင်သွားမယ့်ကောင်ပါ -->
<VBox fx:id="contentArea" spacing="24.0" styleClass="super-content" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="super-topbar">
         <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="super-page-kicker" text="SUPER ADMIN DASHBOARD" />
                  <Label styleClass="super-page-title" text="Airline Operations Overview" />
                  <Label styleClass="super-page-subtitle" text="Monitor bookings, flight activity, revenue, and staff actions from one control room." />
               </children>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="8.0">
               <children>
                  <Label styleClass="super-status-pill" text="Live Monitoring" />
                  <Label styleClass="super-time-label" text="Today" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox spacing="18.0" styleClass="super-metrics-row" VBox.vgrow="NEVER">
         <children>
            <StackPane styleClass="super-metric-card-blue" HBox.hgrow="ALWAYS" />
            <StackPane styleClass="super-metric-card-red" HBox.hgrow="ALWAYS" />
            <StackPane styleClass="super-metric-card-green" HBox.hgrow="ALWAYS" />
            <StackPane styleClass="super-metric-card-gold" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="16.0" styleClass="super-panel" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="super-section-title" text="Recent Activity" />
                              <Label styleClass="super-section-subtitle" text="Latest administrative actions and operational events" />
                           </children>
                        </VBox>
                        <Label styleClass="super-table-chip" text="System Logs" />
                     </children>
                  </HBox>
                  <!-- Dashboard ရဲ့ ဇယား -->
                  <TableView fx:id="activityTable" styleClass="super-table" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn prefWidth="180.0" text="Action" />
                        <TableColumn prefWidth="160.0" text="User" />
                        <TableColumn prefWidth="160.0" text="Date" />
                        <TableColumn prefWidth="420.0" text="Detail" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <placeholder>
                        <Label text="No recent activity yet" />
                     </placeholder>
                  </TableView>
               </children>
            </VBox>
            <VBox prefWidth="310.0" spacing="18.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="12.0" styleClass="super-side-panel">
                     <children>
                        <Label styleClass="super-section-title" text="Flight Health" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="super-dot-green" text=" " />
                              <Label styleClass="super-side-copy" text="Schedule service online" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="super-dot-blue" text=" " />
                              <Label styleClass="super-side-copy" text="Booking desk active" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="super-dot-gold" text=" " />
                              <Label styleClass="super-side-copy" text="Revenue tracking ready" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox spacing="10.0" styleClass="super-side-panel-accent" VBox.vgrow="NEVER">
                     <children>
                        <Label styleClass="super-section-title-light" text="Admin Focus" />
                        <Label styleClass="super-side-copy-light" text="Use account management and system tools to keep staff access and airline operations secure." wrapText="true" />
                     </children>
                  </VBox>
                  <Region VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>

   <stylesheets>
      <URL value="@/com/pos/flightmanagementsystem/Style/SideBar.css" />
   </stylesheets>
</VBox>