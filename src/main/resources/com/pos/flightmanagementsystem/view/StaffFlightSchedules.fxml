<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- 🌟 အနောက်ခံ အရောင်ဝင်စေရန် super-content class ထည့်ပေးထားပါသည် -->
<VBox spacing="20.0" styleClass="super-content" stylesheets="@/com/pos/flightmanagementsystem/Style/StaffFlightSchedulesDark.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" styleClass="header-card">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <children>
                    <!-- Offline Vector Icon Badge (လေယာဉ်ပျံ Icon) -->
                    <StackPane styleClass="icon-badge">
                        <children>
                            <!-- 🌟 Inline fill ကို ဖြုတ်ပြီး CSS ဖြင့် အစားထိုးထားသည် -->
                            <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" scaleX="0.9" scaleY="0.9" styleClass="header-icon-glyph" />
                        </children>
                    </StackPane>
                    <Label styleClass="main-title" text="Flight Schedules" />
                </children>
            </HBox>
        </children>
    </HBox>

    <!-- Content Section -->
    <VBox spacing="15.0" styleClass="content-card" VBox.vgrow="ALWAYS">
        <children>
            <!-- Table ခေါင်းစဉ် (Live Flight Schedules) -->
            <Label styleClass="section-title" text="Live Flight Schedules" />

            <!-- Flight Schedules Table -->
            <TableView fx:id="flightTable" VBox.vgrow="ALWAYS" styleClass="flight-table">
                <columns>
                    <TableColumn fx:id="colFlight" prefWidth="120.0" text="Flight" />
                    <TableColumn fx:id="colRoute" prefWidth="150.0" text="Route" />
                    <TableColumn fx:id="colDeparture" prefWidth="120.0" text="Departure" />
                    <TableColumn fx:id="colArrival" prefWidth="120.0" text="Arrival" />
                    <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </children>
    </VBox>
</VBox>