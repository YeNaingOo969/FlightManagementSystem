<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- 🌟 fx:controller နှင့် fx:id="rootLayout" ကို ထည့်သွင်းထားပါသည် 🌟 -->
<VBox fx:id="rootLayout" spacing="15.0" styleClass="root-layout" stylesheets="@/com/pos/flightmanagementsystem/Style/StaffFlightSchedules.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.StaffViewFlightScheduleController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" styleClass="header-card">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <children>
                    <!-- Offline Vector Icon Badge (လေယာဉ်ပျံ Icon) -->
                    <StackPane styleClass="icon-badge">
                        <children>
                            <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill="#FFFFFF" scaleX="0.8" scaleY="0.8" />
                        </children>
                    </StackPane>
                    <Label styleClass="main-title" text="Flight Schedules" />
                </children>
            </HBox>
        </children>
    </HBox>

    <!-- Content Section -->
    <VBox spacing="15.0" styleClass="content-card" VBox.vgrow="ALWAYS">
        <children>
            <!-- Table ခေါင်းစဉ် (Live Flight Schedules) -->
            <Label styleClass="section-title" text="Live Flight Schedules" />

            <!-- 🌟 Database Flights Table Column များအတိုင်း ပြင်ဆင်ထားသော Table 🌟 -->
            <TableView fx:id="flightTable" VBox.vgrow="ALWAYS" styleClass="flight-table">
                <columns>
                    <TableColumn fx:id="colFlightId" prefWidth="60.0" text="flight_id" />
                    <TableColumn fx:id="colFlightNumber" prefWidth="90.0" text="flight_number" />
                    <TableColumn fx:id="colAirline" prefWidth="100.0" text="airline" />
                    <!-- ID အစား City Name အဖြစ်ပြောင်းထားပါသည် -->
                    <TableColumn fx:id="colDepCityName" prefWidth="110.0" text="departure_city" />
                    <TableColumn fx:id="colArrCityName" prefWidth="110.0" text="arrival_city" />
                    <TableColumn fx:id="colDepTime" prefWidth="130.0" text="departure_time" />
                    <TableColumn fx:id="colArrTime" prefWidth="130.0" text="arrival_time" />
                    <TableColumn fx:id="colTotalSeats" prefWidth="80.0" text="total_seats" />
                    <TableColumn fx:id="colBasePrice" prefWidth="90.0" text="base_price" />
                    <TableColumn fx:id="colStatus" prefWidth="90.0" text="status" />

                    <!-- View Seat Button အတွက် Action Column -->
                    <TableColumn fx:id="colAction" prefWidth="90.0" text="Action" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </children>
    </VBox>
</VBox>