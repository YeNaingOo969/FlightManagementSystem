<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="rootPane" fx:controller="com.pos.flightmanagementsystem.controller.SuperAdminController"
            styleClass="super-dashboard-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ==============================================
         LEFT SIDEBAR
         ============================================== -->
    <left>
        <VBox fx:id="sidebar" prefWidth="262.0" spacing="22.0" styleClass="super-sidebar" BorderPane.alignment="CENTER">
            <children>
                <!-- 🌟 FXML Class များနှင့် Spacing ကို Admin.fxml အတိုင်း အတိအကျ တူညီအောင် ပြင်ဆင်ထားပါသည် 🌟 -->
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="super-brand">
                    <children>
                        <!-- Logo -->
                        <StackPane styleClass="super-brand-logo" minWidth="44" maxWidth="44" minHeight="44" maxHeight="44">
                            <children>
                                <SVGPath content="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z" styleClass="super-brand-logo-glyph" />
                            </children>
                        </StackPane>

                        <!-- Text -->
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS" maxWidth="100">
                            <children>
                                <Label styleClass="super-brand-title" text="FlyPlan" />
                                <Label styleClass="super-brand-kicker" text="Airline Management" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Theme Toggle Switch -->
                        <StackPane fx:id="themeToggleBg" onMouseClicked="#toggleTheme" styleClass="theme-toggle-bg">
                            <StackPane fx:id="themeThumb" styleClass="theme-toggle-thumb" StackPane.alignment="CENTER_LEFT">
                                <SVGPath fx:id="themeIcon" content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" styleClass="theme-icon-glyph" />
                            </StackPane>
                        </StackPane>
                    </children>
                </HBox>

                <!-- Navigation Buttons -->
                <VBox styleClass="nav-menu-box" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#clickDashboard" styleClass="super-nav-button" text="Dashboard">
                            <graphic>
                                <StackPane styleClass="super-nav-icon">
                                    <SVGPath fx:id="iconDashboard" content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" styleClass="super-nav-icon-glyph"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="btnACManage" mnemonicParsing="false" onAction="#clickACManagement" styleClass="super-nav-button" text="Account Management">
                            <graphic>
                                <StackPane styleClass="super-nav-icon">
                                    <SVGPath fx:id="iconACManage" content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" styleClass="super-nav-icon-glyph"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="btnSystemLogs" mnemonicParsing="false" onAction="#clickSystemLogs" styleClass="super-nav-button" text="System Logs">
                            <graphic>
                                <StackPane styleClass="super-nav-icon">
                                    <SVGPath fx:id="iconSystemLogs" content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" styleClass="super-nav-icon-glyph"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="btnSystemTools" mnemonicParsing="false" onAction="#clickSystemTools" styleClass="super-nav-button" text="System Tools">
                            <graphic>
                                <StackPane styleClass="super-nav-icon">
                                    <SVGPath fx:id="iconSystemTools" content="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" styleClass="super-nav-icon-glyph"/>
                                </StackPane>
                            </graphic>
                        </Button>
                    </children>
                </VBox>

                <VBox styleClass="sidebar-status-box">
                    <children>
                        <Label styleClass="status-title" text="Operations Status" />
                        <Label styleClass="status-value" text="All systems normal" />
                        <Label styleClass="status-note" text="Admin console ready" />
                    </children>
                </VBox>

                <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#clickLogout" styleClass="super-logout-button" text="Log Out">
                    <graphic>
                        <StackPane styleClass="super-nav-icon">
                            <SVGPath fx:id="iconLogout" content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" styleClass="super-nav-icon-glyph"/>
                        </StackPane>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- ==============================================
         RIGHT MAIN CONTENT AREA & OVERLAYS
         ============================================== -->
    <center>
        <StackPane fx:id="rightSideStack" style="-fx-background-color: transparent;">

            <!-- ပုံမှန် မြင်နေရမည့် Top Nav နှင့် Pages များ -->
            <BorderPane styleClass="main-content-wrapper">
                <top>
                    <HBox styleClass="global-top-nav" BorderPane.alignment="CENTER">
                        <children>
                            <!-- Notification Icon -->
                            <StackPane styleClass="nav-notification-btn">
                                <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" styleClass="nav-bell-icon" />
                            </StackPane>

                            <!-- PFP ကို နှိပ်လျှင် Popup ပေါ်လာစေရန် onMouseClicked ထည့်ထားသည် -->
                            <HBox fx:id="navProfileBox" onMouseClicked="#openProfilePopup" styleClass="nav-profile-box">
                                <children>
                                    <StackPane styleClass="nav-profile-avatar">
                                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="nav-profile-avatar-icon" />
                                    </StackPane>
                                    <VBox styleClass="nav-profile-text-box">
                                        <children>
                                            <Label fx:id="topNavUsername" styleClass="nav-profile-name" text="SuperAdmin" />
                                            <Label fx:id="topNavRole" styleClass="nav-profile-role" text="Loading..." />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                        </children>
                    </HBox>
                </top>
                <center>
                    <StackPane fx:id="mainContentArea" styleClass="main-content-area" BorderPane.alignment="CENTER" />
                </center>
            </BorderPane>

            <!-- Floating Profile Overlay Layer -->
            <StackPane fx:id="profileOverlayBg" onMouseClicked="#closeProfilePopup" style="-fx-background-color: rgba(6, 8, 13, 0.6);" visible="false">
                <children>
                    <!-- Profile.fxml ကို ဤ Container အတွင်းသို့ Load လုပ်မည် -->
                    <StackPane fx:id="profilePopupContainer" maxHeight="-Infinity" maxWidth="-Infinity" StackPane.alignment="CENTER" />
                </children>
            </StackPane>

        </StackPane>
    </center>

    <stylesheets>
        <URL value="@/com/pos/flightmanagementsystem/Style/SuperAdminSideBarDark.css" />
    </stylesheets>
</BorderPane>