<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="profileRoot" style="-fx-background-color: transparent;" styleClass="profile-page" stylesheets="@/com/pos/flightmanagementsystem/Style/ProfileDark.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.ProfileController">

   <children>
      <!-- State 1: Profile View -->
      <StackPane fx:id="profileView">
         <children>
            <!-- 🌟 MAIN SPLIT CARD 🌟 -->
            <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="500.0" prefHeight="530.0" prefWidth="900.0" styleClass="profile-main-card" StackPane.alignment="CENTER">
               <children>

                  <!-- ==============================================
                       LEFT PANE: VISUAL IDENTITY & ACTIONS
                       ============================================== -->
                  <VBox alignment="CENTER" prefWidth="310.0" spacing="14.0" styleClass="profile-left-pane">
                     <children>
                        <!-- 🌟 Glowing Avatar + Floating Camera Button 🌟 -->
                        <StackPane maxHeight="120.0" maxWidth="120.0" prefHeight="120.0" prefWidth="120.0">
                           <children>
                              <StackPane styleClass="profile-avatar-glow">
                                 <children>
                                    <Circle fx:id="profileAvatarCircle" fill="#31C4B4" radius="52.0" />
                                 </children>
                              </StackPane>

                              <!-- Camera Overlay Button -->
                              <Button fx:id="btnChangeAvatar" mnemonicParsing="false" onAction="#chooseAvatarImage" styleClass="avatar-camera-btn" StackPane.alignment="BOTTOM_RIGHT">
                                 <graphic>
                                    <SVGPath content="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm0-8.4c2.87 0 5.2 2.33 5.2 5.2s-2.33 5.2-5.2 5.2-5.2-2.33-5.2-5.2 2.33-5.2 5.2-5.2zM9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9z" styleClass="avatar-camera-icon" />
                                 </graphic>
                                 <StackPane.margin>
                                    <Insets bottom="2.0" right="2.0" />
                                 </StackPane.margin>
                              </Button>
                           </children>
                        </StackPane>

                        <!-- Name, Role & Online Status -->
                        <VBox alignment="CENTER" spacing="8.0">
                           <children>
                              <Label fx:id="lblFullName" styleClass="profile-name-lg" text="Loading..." wrapText="true" />
                              <Label fx:id="lblRole" styleClass="profile-role-badge" text="STAFF" />

                              <HBox alignment="CENTER" maxWidth="-Infinity" spacing="6.0" styleClass="online-status-box">
                                 <children>
                                    <Circle radius="4.0" styleClass="online-dot" />
                                    <Label styleClass="online-text" text="Online • FlyPlan Portal" />
                                 </children>
                                 <VBox.margin>
                                    <Insets top="4.0" />
                                 </VBox.margin>
                              </HBox>
                           </children>
                           <VBox.margin>
                              <Insets top="6.0" />
                           </VBox.margin>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Left Pane Action Buttons -->
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Button fx:id="btnEditProfile" mnemonicParsing="false" onAction="#toggleEditMode" styleClass="profile-btn-edit" text="Edit Profile">
                                 <graphic>
                                    <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" styleClass="profile-edit-icon-glyph" />
                                 </graphic>
                              </Button>

                              <!-- Change Password Button -->
                              <Button fx:id="btnChangePassword" mnemonicParsing="false" onAction="#showPasswordView" styleClass="profile-btn-change-pw" text="Change Password">
                                 <graphic>
                                    <StackPane styleClass="profile-button-icon">
                                       <children>
                                          <SVGPath content="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2ZM10 6a2 2 0 0 1 4 0v2h-4V6Zm3 10.73V18h-2v-1.27a2 2 0 1 1 2 0Z" styleClass="profile-btn-icon-glyph" />
                                       </children>
                                    </StackPane>
                                 </graphic>
                              </Button>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- ==============================================
                       RIGHT PANE: BENTO GRID & INLINE EDIT
                       ============================================== -->
                  <VBox spacing="22.0" styleClass="profile-right-pane" HBox.hgrow="ALWAYS">
                     <children>
                        <!-- Header, Save/Cancel Bar & Close Button -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <VBox spacing="4.0">
                                 <children>
                                    <Label styleClass="profile-section-title" text="Account Information" />
                                    <Label fx:id="lblSectionSubtitle" styleClass="profile-section-subtitle" text="View and manage your registered airline staff details" />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />

                              <!-- Edit Mode Save / Cancel Buttons -->
                              <HBox fx:id="editActionBox" alignment="CENTER_RIGHT" managed="false" spacing="10.0" visible="false">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#cancelEditMode" styleClass="profile-btn-cancel" text="Cancel" />
                                    <Button mnemonicParsing="false" onAction="#saveProfileChanges" styleClass="profile-btn-save" text="Save Changes" />
                                 </children>
                              </HBox>

                              <!-- Close Button -->
                              <Button mnemonicParsing="false" onAction="#clickClose" styleClass="profile-close-btn">
                                 <graphic>
                                    <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" styleClass="profile-close-icon" />
                                 </graphic>
                              </Button>
                           </children>
                        </HBox>

                        <!-- Row 1: Editable Cards (Username & Email) -->
                        <HBox spacing="18.0">
                           <children>
                              <!-- Full Name / Username Card -->
                              <VBox fx:id="cardUsername" prefWidth="260.0" spacing="12.0" styleClass="info-mini-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <StackPane styleClass="info-icon-box">
                                             <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="info-icon-glyph" />
                                          </StackPane>
                                          <Label styleClass="info-label" text="Display Name" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="badgeEditName" styleClass="editable-tag" text="EDITABLE" />
                                       </children>
                                    </HBox>
                                    <StackPane alignment="CENTER_LEFT">
                                       <children>
                                          <Label fx:id="lblUsernameCard" styleClass="info-value" text="Loading..." />
                                          <TextField fx:id="txtUsername" managed="false" promptText="Enter username" styleClass="info-edit-field" visible="false" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </VBox>

                              <!-- Email Address Card -->
                              <VBox fx:id="cardEmail" prefWidth="260.0" spacing="12.0" styleClass="info-mini-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <StackPane styleClass="info-icon-box">
                                             <SVGPath content="M3 5h18v14H3V5Zm2 3.2V17h14V8.2l-7 5.1-7-5.1Zm1.25-1.2L12 11.18 17.75 7H6.25Z" styleClass="info-icon-glyph" />
                                          </StackPane>
                                          <Label styleClass="info-label" text="Email Address" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="badgeEditEmail" styleClass="editable-tag" text="EDITABLE" />
                                       </children>
                                    </HBox>
                                    <StackPane alignment="CENTER_LEFT">
                                       <children>
                                          <Label fx:id="lblEmail" styleClass="info-value" text="Loading..." />
                                          <TextField fx:id="txtEmail" managed="false" promptText="Enter email address" styleClass="info-edit-field" visible="false" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Row 2: System Cards (Employee ID & Security Role) -->
                        <HBox spacing="18.0">
                           <children>
                              <!-- Employee ID Card -->
                              <VBox prefWidth="260.0" spacing="12.0" styleClass="info-mini-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <StackPane styleClass="info-icon-box">
                                             <SVGPath content="M3 5h18v14H3V5Zm2 2v10h14V7H5Zm2 2h5v2H7V9Zm0 4h7v2H7v-2Zm9-3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm-1 5c.22-1.35 1.28-2.25 2.5-2.25s2.28.9 2.5 2.25h-5Z" styleClass="info-icon-glyph" />
                                          </StackPane>
                                          <Label styleClass="info-label" text="Employee ID" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label styleClass="locked-tag" text="SYSTEM ID" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblEmployeeId" styleClass="info-value-accent" text="Loading..." />
                                 </children>
                              </VBox>

                              <!-- Security Clearance / Role Card -->
                              <VBox prefWidth="260.0" spacing="12.0" styleClass="info-mini-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <StackPane styleClass="info-icon-box">
                                             <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" styleClass="info-icon-glyph" />
                                          </StackPane>
                                          <Label styleClass="info-label" text="Access Clearance" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label styleClass="locked-tag" text="VERIFIED" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblClearanceRole" styleClass="info-value" text="Loading..." />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Status Banner -->
                        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="status-banner">
                           <children>
                              <StackPane styleClass="status-check-bg">
                                 <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" styleClass="status-check-glyph" />
                              </StackPane>
                              <VBox alignment="CENTER_LEFT" spacing="2.0">
                                 <children>
                                    <Label styleClass="status-banner-title" text="Account Active &amp; Secured" />
                                    <Label styleClass="status-banner-desc" text="Click 'Edit Profile' or the camera icon on your photo to update your details." />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </StackPane>

      <!-- 🌟 MODAL OVERLAYS (For PW Change) 🌟 -->
      <StackPane fx:id="modalOverlay" styleClass="modal-overlay-bg" visible="false" />

      <!-- 🌟 Notification Toast 🌟 -->
      <HBox fx:id="notificationToast" alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="340.0" spacing="15.0" styleClass="toast-notification-dark" visible="false" StackPane.alignment="BOTTOM_RIGHT">
         <children>
            <StackPane styleClass="toast-icon-bg">
               <children>
                  <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" styleClass="toast-icon-glyph" />
               </children>
               <HBox.margin>
                  <Insets top="2.0" />
               </HBox.margin>
            </StackPane>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblToastTitle" styleClass="toast-title" text="Success!" />
                  <Label fx:id="lblToastMessage" styleClass="toast-message" text="Changes saved successfully." wrapText="true" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#closeNotification" styleClass="toast-close-btn">
               <graphic>
                  <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" styleClass="toast-close-icon" />
               </graphic>
               <HBox.margin>
                  <Insets top="-4.0" />
               </HBox.margin>
            </Button>
         </children>
         <StackPane.margin>
            <Insets bottom="30.0" right="30.0" />
         </StackPane.margin>
      </HBox>

   </children>
</StackPane>