<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- 🌟 Root ကို Background ဖောက်ထွင်းမြင်ရအောင် (transparent) ပြင်ထားပါသည် 🌟 -->
<StackPane fx:id="profileRoot" style="-fx-background-color: transparent;" styleClass="profile-page" stylesheets="@/com/pos/flightmanagementsystem/Style/ProfileDark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.ProfileController">

   <children>
      <!-- State 1: Profile View -->
      <StackPane fx:id="profileView">
         <children>
            <!-- 🌟 MAIN SPLIT CARD 🌟 -->
            <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="450.0" prefHeight="500.0" prefWidth="850.0" styleClass="profile-main-card" StackPane.alignment="CENTER">
               <children>

                  <!-- ==============================================
                       LEFT PANE: VISUAL IDENTITY
                       ============================================== -->
                  <VBox alignment="CENTER" prefWidth="320.0" spacing="15.0" styleClass="profile-left-pane">
                     <children>
                        <!-- 🌟 Glowing Avatar (Circle ဖြင့် ပုံအစစ်ပြရန်) 🌟 -->
                        <StackPane styleClass="profile-avatar-glow">
                           <children>
                              <Circle fx:id="profileAvatarCircle" fill="#31C4B4" radius="45.0" />
                           </children>
                        </StackPane>

                        <!-- Name & Role -->
                        <VBox alignment="CENTER" spacing="8.0">
                           <children>
                              <Label fx:id="lblFullName" styleClass="profile-name-lg" text="Loading..." />
                              <Label fx:id="lblRole" styleClass="profile-role-badge" text="..." />
                           </children>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Change Password Button -->
                        <Button fx:id="btnChangePassword" mnemonicParsing="false" onAction="#showPasswordView" styleClass="profile-btn-change-pw" text="Change Password">
                           <graphic>
                              <StackPane styleClass="profile-button-icon">
                                 <children>
                                    <SVGPath content="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2ZM10 6a2 2 0 0 1 4 0v2h-4V6Zm3 10.73V18h-2v-1.27a2 2 0 1 1 2 0Z" styleClass="profile-btn-icon-glyph" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </Button>
                     </children>
                  </VBox>

                  <!-- ==============================================
                       RIGHT PANE: DATA DETAILS
                       ============================================== -->
                  <VBox spacing="30.0" styleClass="profile-right-pane" HBox.hgrow="ALWAYS">
                     <children>
                        <!-- Header & Close Button 🌟 -->
                        <HBox alignment="TOP_LEFT">
                           <children>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="profile-section-title" text="Account Information" />
                                    <Label styleClass="profile-section-subtitle" text="View your registered airline staff details" />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />
                              <!-- Close Button 🌟 -->
                              <Button mnemonicParsing="false" onAction="#clickClose" style="-fx-background-color: transparent; -fx-cursor: hand;">
                                 <graphic>
                                    <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="#8B95A5" scaleX="1.3" scaleY="1.3" />
                                 </graphic>
                              </Button>
                           </children>
                        </HBox>

                        <!-- Mini Data Cards Grid -->
                        <HBox spacing="20.0">
                           <children>
                              <!-- Email Card -->
                              <VBox spacing="10.0" styleClass="info-mini-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <StackPane styleClass="info-icon-box">
                                             <SVGPath content="M3 5h18v14H3V5Zm2 3.2V17h14V8.2l-7 5.1-7-5.1Zm1.25-1.2L12 11.18 17.75 7H6.25Z" styleClass="info-icon-glyph" />
                                          </StackPane>
                                          <Label styleClass="info-label" text="Email Address" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblEmail" styleClass="info-value" text="Loading..." />
                                 </children>
                              </VBox>

                              <!-- Employee ID Card -->
                              <VBox spacing="10.0" styleClass="info-mini-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <StackPane styleClass="info-icon-box">
                                             <SVGPath content="M3 5h18v14H3V5Zm2 2v10h14V7H5Zm2 2h5v2H7V9Zm0 4h7v2H7v-2Zm9-3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm-1 5c.22-1.35 1.28-2.25 2.5-2.25s2.28.9 2.5 2.25h-5Z" styleClass="info-icon-glyph" />
                                          </StackPane>
                                          <Label styleClass="info-label" text="Employee ID" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblEmployeeId" styleClass="info-value-accent" text="Loading..." />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Status Banner -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="status-banner">
                           <children>
                              <StackPane styleClass="status-check-bg">
                                 <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" styleClass="status-check-glyph" />
                              </StackPane>
                              <VBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="status-banner-title" text="Account Active" />
                                    <Label styleClass="status-banner-desc" text="System access is fully verified and secure." />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </StackPane>

      <!-- 🌟 MODAL OVERLAYS (For PW Change) 🌟 -->
      <StackPane fx:id="modalOverlay" styleClass="modal-overlay-bg" visible="false" />

      <!-- 🌟 Success Notification Toast 🌟 -->
      <HBox fx:id="notificationToast" alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="320.0" spacing="15.0" styleClass="toast-notification-dark" visible="false" StackPane.alignment="BOTTOM_RIGHT">
         <children>
            <StackPane styleClass="toast-icon-bg">
               <children>
                  <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" styleClass="toast-icon-glyph" />
               </children>
               <HBox.margin>
                  <Insets top="2.0" />
               </HBox.margin>
            </StackPane>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="toast-title" text="Success!" />
                  <Label styleClass="toast-message" text="Password changed successfully." wrapText="true" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#closeNotification" styleClass="toast-close-btn">
               <graphic>
                  <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" styleClass="toast-close-icon" />
               </graphic>
               <HBox.margin>
                  <Insets top="-4.0" />
               </HBox.margin>
            </Button>
         </children>
         <StackPane.margin>
            <Insets bottom="30.0" right="30.0" />
         </StackPane.margin>
      </HBox>

   </children>
</StackPane>