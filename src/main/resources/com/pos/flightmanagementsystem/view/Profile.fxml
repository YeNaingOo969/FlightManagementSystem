<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="profileRoot" maxHeight="1.7976931348623157E308" prefHeight="650.0" prefWidth="1200.0" styleClass="profile-page" stylesheets="@/com/pos/flightmanagementsystem/Style/designProfile.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.ProfileController">

   <children>
      <!-- State 1: Profile View -->
      <StackPane fx:id="profileView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>
            <VBox maxHeight="-Infinity" maxWidth="980.0" minHeight="560.0" prefHeight="560.0" spacing="0.0" styleClass="profile-card" StackPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="22.0" styleClass="profile-card-header">
                     <children>
                        <StackPane styleClass="profile-section-icon">
                           <children>
                              <SVGPath content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" styleClass="profile-section-icon-glyph" />
                           </children>
                        </StackPane>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="profile-card-title" text="Personal Details" />
                              <Label styleClass="profile-card-subtitle" text="View and manage your personal information" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Region prefHeight="1.0" styleClass="profile-divider" />
                  <VBox spacing="0.0" styleClass="profile-details-list">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="profile-detail-row">
                           <children>
                              <StackPane styleClass="profile-row-icon">
                                 <children>
                                    <SVGPath content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" styleClass="profile-row-icon-glyph" />
                                 </children>
                              </StackPane>
                              <Label minWidth="230.0" styleClass="profile-label" text="Full Name" />
                              <Label fx:id="lblFullName" styleClass="profile-value" text="Loading..." />
                           </children>
                        </HBox>
                        <Region prefHeight="1.0" styleClass="profile-divider" />
                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="profile-detail-row">
                           <children>
                              <StackPane styleClass="profile-row-icon">
                                 <children>
                                    <SVGPath content="M3 5h18v14H3V5Zm2 3.2V17h14V8.2l-7 5.1-7-5.1Zm1.25-1.2L12 11.18 17.75 7H6.25Z" styleClass="profile-row-icon-glyph" />
                                 </children>
                              </StackPane>
                              <Label minWidth="230.0" styleClass="profile-label" text="Email" />
                              <Label fx:id="lblEmail" styleClass="profile-value" text="Loading..." />
                           </children>
                        </HBox>
                        <Region prefHeight="1.0" styleClass="profile-divider" />
                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="profile-detail-row">
                           <children>
                              <StackPane styleClass="profile-row-icon">
                                 <children>
                                    <SVGPath content="M12 2 4 5.5V11c0 5.05 3.41 9.76 8 11 4.59-1.24 8-5.95 8-11V5.5L12 2Zm3.55 7.45-4.24 4.24-2.12-2.12-1.41 1.41 3.53 3.53 5.66-5.66-1.42-1.4Z" styleClass="profile-row-icon-glyph" />
                                 </children>
                              </StackPane>
                              <Label minWidth="230.0" styleClass="profile-label" text="Role" />
                              <Label fx:id="lblRole" styleClass="profile-role-pill" text="Loading..." />
                           </children>
                        </HBox>
                        <Region prefHeight="1.0" styleClass="profile-divider" />
                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="profile-detail-row">
                           <children>
                              <StackPane styleClass="profile-row-icon">
                                 <children>
                                    <SVGPath content="M3 5h18v14H3V5Zm2 2v10h14V7H5Zm2 2h5v2H7V9Zm0 4h7v2H7v-2Zm9-3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm-1 5c.22-1.35 1.28-2.25 2.5-2.25s2.28.9 2.5 2.25h-5Z" styleClass="profile-row-icon-glyph" />
                                 </children>
                              </StackPane>
                              <Label minWidth="230.0" styleClass="profile-label" text="Employee ID" />
                              <Label fx:id="lblEmployeeId" styleClass="profile-value" text="Loading..." />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_LEFT" styleClass="profile-action-row" VBox.vgrow="ALWAYS">
                     <children>
                        <Button fx:id="btnChangePassword" mnemonicParsing="false" onAction="#showPasswordView" styleClass="danger-action-button" text="Change Password">
                           <graphic>
                              <StackPane styleClass="profile-button-icon">
                                 <children>
                                    <SVGPath content="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2ZM10 6a2 2 0 0 1 4 0v2h-4V6Zm3 10.73V18h-2v-1.27a2 2 0 1 1 2 0Z" styleClass="profile-button-icon-glyph" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- ========================================== -->
      <!-- Success Notification Toast (ညာဘက်အောက်) -->
      <!-- ========================================== -->
      <HBox fx:id="notificationToast" alignment="TOP_LEFT" prefWidth="320.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);" visible="false" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0">
         <padding>
            <Insets bottom="16.0" left="20.0" right="12.0" top="16.0" />
         </padding>
         <children>
            <!-- အစိမ်းရောင် အမှန်ခြစ် Icon -->
            <StackPane style="-fx-background-color: #10b981; -fx-background-radius: 50%;">
               <padding>
                  <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
               </padding>
               <children>
                  <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="white" />
               </children>
               <HBox.margin>
                  <Insets top="2.0" />
               </HBox.margin>
            </StackPane>

            <!-- စာသားများ -->
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Success!" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #4b5563;" text="Password changed successfully." wrapText="true" />
               </children>
            </VBox>

            <!-- ကြက်ခြေခတ် (X) ခလုတ် -->
            <Button mnemonicParsing="false" onAction="#closeNotification" style="-fx-background-color: transparent; -fx-cursor: hand;">
               <graphic>
                  <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="#9ca3af" />
               </graphic>
               <HBox.margin>
                  <Insets top="-4.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>

   </children>
</AnchorPane>