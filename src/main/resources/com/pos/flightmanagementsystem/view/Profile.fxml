<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="profileRoot" maxHeight="1.7976931348623157E308" prefHeight="650.0" prefWidth="1200.0" styleClass="profile-page" stylesheets="@../CssFile/designProfile.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfileController">

   <children>

      <!-- State 1: View Personal Detail -->
      <VBox fx:id="profileView" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="profile-topbar">
               <children>
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="profile-page-title" text="Profile" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="profile-breadcrumb-muted" text="Home" />
                              <Label styleClass="profile-breadcrumb-arrow" text="&gt;" />
                              <Label styleClass="profile-breadcrumb-active" text="Profile" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" spacing="18.0">
                     <children>
                        <StackPane styleClass="profile-bell">
                           <children>
                              <SVGPath content="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6v-5c0-3.07-1.63-5.64-4.5-6.32V4a2.5 2.5 0 0 0-5 0v.68C6.63 5.36 5 7.92 5 11v5l-2 2v1h18v-1l-2-2Z" styleClass="profile-bell-glyph" />
                              <Region styleClass="profile-notification-dot" StackPane.alignment="TOP_RIGHT" />
                           </children>
                        </StackPane>
                        <Region prefHeight="42.0" prefWidth="1.0" styleClass="profile-header-divider" />
                        <StackPane styleClass="profile-avatar">
                           <children>
                              <Label styleClass="profile-avatar-text" text="AU" />
                           </children>
                        </StackPane>
                        <VBox spacing="3.0">
                           <children>
                              <Label styleClass="profile-user-name" text="Admin User" />
                              <Label styleClass="profile-user-role" text="Super Administrator" />
                           </children>
                        </VBox>
                        <SVGPath content="M7 10l5 5 5-5H7Z" styleClass="profile-dropdown-glyph" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <VBox maxWidth="980.0" spacing="0.0" styleClass="profile-card" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="22.0" styleClass="profile-card-header">
                     <children>
                        <StackPane styleClass="profile-section-icon">
                           <children>
                              <SVGPath content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" styleClass="profile-section-icon-glyph" />
                           </children>
                        </StackPane>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="profile-card-title" text="Personal Details" />
                              <Label styleClass="profile-card-subtitle" text="View and manage your personal information" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Region prefHeight="1.0" styleClass="profile-divider" />
                  <VBox spacing="0.0" styleClass="profile-details-list">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="profile-detail-row">
                           <children>
                              <StackPane styleClass="profile-row-icon">
                                 <children>
                                    <SVGPath content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" styleClass="profile-row-icon-glyph" />
                                 </children>
                              </StackPane>
                              <Label minWidth="230.0" styleClass="profile-label" text="Full Name" />
                              <Label styleClass="profile-value" text="Admin User" />
                           </children>
                        </HBox>
                        <Region prefHeight="1.0" styleClass="profile-divider" />
                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="profile-detail-row">
                           <children>
                              <StackPane styleClass="profile-row-icon">
                                 <children>
                                    <SVGPath content="M3 5h18v14H3V5Zm2 3.2V17h14V8.2l-7 5.1-7-5.1Zm1.25-1.2L12 11.18 17.75 7H6.25Z" styleClass="profile-row-icon-glyph" />
                                 </children>
                              </StackPane>
                              <Label minWidth="230.0" styleClass="profile-label" text="Email" />
                              <Label styleClass="profile-value" text="admin@airline.com" />
                           </children>
                        </HBox>
                        <Region prefHeight="1.0" styleClass="profile-divider" />
                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="profile-detail-row">
                           <children>
                              <StackPane styleClass="profile-row-icon">
                                 <children>
                                    <SVGPath content="M12 2 4 5.5V11c0 5.05 3.41 9.76 8 11 4.59-1.24 8-5.95 8-11V5.5L12 2Zm3.55 7.45-4.24 4.24-2.12-2.12-1.41 1.41 3.53 3.53 5.66-5.66-1.42-1.4Z" styleClass="profile-row-icon-glyph" />
                                 </children>
                              </StackPane>
                              <Label minWidth="230.0" styleClass="profile-label" text="Role" />
                              <Label styleClass="profile-role-pill" text="Super Administrator" />
                           </children>
                        </HBox>
                        <Region prefHeight="1.0" styleClass="profile-divider" />
                        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="profile-detail-row">
                           <children>
                              <StackPane styleClass="profile-row-icon">
                                 <children>
                                    <SVGPath content="M3 5h18v14H3V5Zm2 2v10h14V7H5Zm2 2h5v2H7V9Zm0 4h7v2H7v-2Zm9-3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm-1 5c.22-1.35 1.28-2.25 2.5-2.25s2.28.9 2.5 2.25h-5Z" styleClass="profile-row-icon-glyph" />
                                 </children>
                              </StackPane>
                              <Label minWidth="230.0" styleClass="profile-label" text="Employee ID" />
                              <Label styleClass="profile-value" text="EMP-0001" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_LEFT" styleClass="profile-action-row">
                     <children>
                        <Button fx:id="btnChangePassword" mnemonicParsing="false" onAction="#clickChangePassword" styleClass="danger-action-button" text="Change Password">
                           <graphic>
                              <StackPane styleClass="profile-button-icon">
                                 <children>
                                    <SVGPath content="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2ZM10 6a2 2 0 0 1 4 0v2h-4V6Zm3 10.73V18h-2v-1.27a2 2 0 1 1 2 0Z" styleClass="profile-button-icon-glyph" />
                                 </children>
                              </StackPane>
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="22.0" left="40.0" right="40.0" top="22.0" />
         </padding>
      </VBox>


      <!-- State 2: Change Password -->
      <VBox fx:id="passwordView" managed="false" spacing="20.0" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox spacing="8.0">
               <children>
                  <Label styleClass="profile-page-title" text="Change Password" />
                  <Label styleClass="profile-card-subtitle" text="Update your administrator sign-in password" />
               </children>
            </VBox>
            <VBox maxWidth="640.0" spacing="18.0" styleClass="profile-card">
               <children>
                  <Label styleClass="profile-card-title" text="Input New Password" />
                  <PasswordField fx:id="txtNewPassword" promptText="New Password" styleClass="profile-input" />
                  <PasswordField fx:id="txtConfirmPassword" promptText="Confirm Password" styleClass="profile-input" />
                  <Label fx:id="lblPasswordError" styleClass="profile-error" text="" />
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="22.0" left="40.0" right="40.0" top="22.0" />
         </padding>
      </VBox>


      <!-- State 3: Success Toast -->
      <Label fx:id="lblSuccessToast" managed="false" styleClass="success-toast" text="Update Successful!" visible="false" AnchorPane.rightAnchor="36.0" AnchorPane.topAnchor="28.0" />

   </children>
</AnchorPane>
