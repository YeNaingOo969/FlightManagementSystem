<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="rootStackPane" styleClass="super-content" stylesheets="@/com/pos/flightmanagementsystem/Style/StaffManageBookingDark.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.StaffManageBookingController">

    <VBox fx:id="mainContainer" spacing="20.0" styleClass="root-layout">
        <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
        </padding>

        <HBox alignment="CENTER_LEFT" styleClass="header-card">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <StackPane styleClass="icon-badge">
                            <children>
                                <SVGPath content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" scaleX="0.9" scaleY="0.9" styleClass="header-icon-glyph" />
                            </children>
                        </StackPane>
                        <Label styleClass="main-title" text="Manage Booking" />
                    </children>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- 🌟 ညာဘက်အပေါ်ထောင့် Search Box 🌟 -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-box" style="-fx-background-color: transparent; -fx-border-color: #31C4B4; -fx-border-radius: 8; -fx-padding: 4 12;">
                    <children>
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#94A3B8" />
                        <TextField fx:id="searchField" prefWidth="250.0" promptText="Search by Booking ID or Passenger..." style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #64748B;" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <VBox spacing="15.0" styleClass="content-card" VBox.vgrow="ALWAYS">
            <children>
                <HBox spacing="30.0" styleClass="tab-container">
                    <children>
                        <Label fx:id="lblTabAll" onMouseClicked="#filterAll" styleClass="tab-label, active-tab" text="All Bookings" />
                        <Label fx:id="lblTabCompleted" onMouseClicked="#filterCompleted" styleClass="tab-label" text="Completed" />
                        <Label fx:id="lblTabCancelled" onMouseClicked="#filterCancelled" styleClass="tab-label" text="Cancelled" />
                    </children>
                </HBox>

                <TableView fx:id="bookingTable" styleClass="booking-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colBookingId" prefWidth="120.0" text="Booking ID" />
                        <TableColumn fx:id="colPassenger" prefWidth="180.0" text="Passenger" />
                        <TableColumn fx:id="colRoute" prefWidth="150.0" text="Route" />
                        <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                        <TableColumn fx:id="colAction" prefWidth="120.0" styleClass="action-column" text="Action" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </VBox>

    <StackPane fx:id="waitingModal" styleClass="overlay-bg" visible="false">
        <children>
            <VBox alignment="TOP_CENTER" maxWidth="400.0" maxHeight="260.0" spacing="15.0" styleClass="waiting-card">
                <children>
                    <HBox alignment="CENTER_RIGHT">
                        <children>
                            <Button mnemonicParsing="false" onAction="#closeWaitingModal" styleClass="close-btn">
                                <graphic>
                                    <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" styleClass="close-icon" />
                                </graphic>
                            </Button>
                        </children>
                    </HBox>

                    <VBox alignment="CENTER" spacing="15.0">
                        <children>
                            <SVGPath fx:id="modalSpinnerIcon" content="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" scaleX="2.0" scaleY="2.0" styleClass="waiting-icon" />
                            <Label styleClass="waiting-title" text="Waiting for admin approval..." />
                            <Label styleClass="waiting-subtitle" text="Your cancellation request has been sent to the admin. You can close this window to continue working." textAlignment="CENTER" wrapText="true" />
                        </children>
                    </VBox>
                </children>
            </VBox>
        </children>
    </StackPane>

</StackPane>