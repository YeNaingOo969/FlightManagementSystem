<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- 🌟 Sidebar ဖယ်ရှားလိုက်ပြီး AnchorPane ဖြင့်သာ စတင်ထားသည် (Main Dashboard ၏ Center တွင် နေရာယူရန်) -->
<AnchorPane maxHeight="1.7976931348623157E308" prefHeight="650.0" prefWidth="950.0" styleClass="profile-page" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminProfile.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <!-- 🌟 Profile Card (ဒုတိယပုံပါ ဒီဇိုင်းအတိုင်း) -->
                <VBox maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="560.0" prefHeight="580.0" spacing="0.0" styleClass="profile-card" StackPane.alignment="CENTER">
                    <children>

                        <!-- 🌟 HEADER: Big Avatar နှင့် Title -->
                        <HBox alignment="CENTER_LEFT" spacing="25.0" styleClass="profile-card-header" style="-fx-padding: 10 0 30 0; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
                            <children>
                                <!-- Big Profile Avatar -->
                                <StackPane style="-fx-background-color: linear-gradient(to bottom right, #0ea5e9, #14b8a6); -fx-background-radius: 50%; -fx-min-width: 80; -fx-min-height: 80; -fx-effect: dropshadow(three-pass-box, rgba(14, 165, 233, 0.4), 15, 0, 0, 5);">
                                    <children>
                                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="white" scaleX="1.8" scaleY="1.8" />
                                    </children>
                                </StackPane>
                                <VBox alignment="CENTER_LEFT" spacing="6.0">
                                    <children>
                                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Personal Details" />
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="View and manage your personal information" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- 🌟 DETAILS LIST (Default Data များဖြင့်) -->
                        <VBox spacing="0.0" style="-fx-padding: 15 0 0 0;">
                            <children>

                                <!-- Row 1: Full Name -->
                                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="profile-detail-row">
                                    <children>
                                        <StackPane styleClass="profile-row-icon">
                                            <children>
                                                <SVGPath content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" styleClass="profile-row-icon-glyph" />
                                            </children>
                                        </StackPane>
                                        <Label minWidth="250.0" styleClass="profile-label" text="Full Name" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="profile-value" text="Staff User" />
                                    </children>
                                </HBox>

                                <!-- Row 2: Email -->
                                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="profile-detail-row">
                                    <children>
                                        <StackPane styleClass="profile-row-icon">
                                            <children>
                                                <SVGPath content="M3 5h18v14H3V5Zm2 3.2V17h14V8.2l-7 5.1-7-5.1Zm1.25-1.2L12 11.18 17.75 7H6.25Z" styleClass="profile-row-icon-glyph" />
                                            </children>
                                        </StackPane>
                                        <Label minWidth="250.0" styleClass="profile-label" text="Email Address" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="profile-value" text="staff@flyplan.com" />
                                    </children>
                                </HBox>

                                <!-- Row 3: Role -->
                                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="profile-detail-row">
                                    <children>
                                        <StackPane styleClass="profile-row-icon">
                                            <children>
                                                <SVGPath content="M12 2 4 5.5V11c0 5.05 3.41 9.76 8 11 4.59-1.24 8-5.95 8-11V5.5L12 2Zm3.55 7.45-4.24 4.24-2.12-2.12-1.41 1.41 3.53 3.53 5.66-5.66-1.42-1.4Z" styleClass="profile-row-icon-glyph" />
                                            </children>
                                        </StackPane>
                                        <Label minWidth="250.0" styleClass="profile-label" text="System Role" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <!-- Staff Role Pill အရောင်ခွဲထားသည် -->
                                        <Label styleClass="profile-role-pill" style="-fx-background-color: #dcfce7; -fx-text-fill: #166534;" text="Staff" />
                                    </children>
                                </HBox>

                                <!-- Row 4: Employee ID -->
                                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="profile-detail-row" style="-fx-border-width: 0;">
                                    <children>
                                        <StackPane styleClass="profile-row-icon">
                                            <children>
                                                <SVGPath content="M3 5h18v14H3V5Zm2 2v10h14V7H5Zm2 2h5v2H7V9Zm0 4h7v2H7v-2Zm9-3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm-1 5c.22-1.35 1.28-2.25 2.5-2.25s2.28.9 2.5 2.25h-5Z" styleClass="profile-row-icon-glyph" />
                                            </children>
                                        </StackPane>
                                        <Label minWidth="250.0" styleClass="profile-label" text="Employee ID" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="profile-value" style="-fx-text-fill: #6366f1;" text="EMP-1024" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- 🌟 ACTION ROW (Change Password Button) -->
                        <HBox alignment="CENTER_RIGHT" styleClass="profile-action-row" VBox.vgrow="ALWAYS">
                            <children>
                                <Button mnemonicParsing="false" styleClass="danger-action-button" text="Change Password">
                                    <graphic>
                                        <StackPane styleClass="profile-button-icon">
                                            <children>
                                                <SVGPath content="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2ZM10 6a2 2 0 0 1 4 0v2h-4V6Zm3 10.73V18h-2v-1.27a2 2 0 1 1 2 0Z" styleClass="profile-button-icon-glyph" />
                                            </children>
                                        </StackPane>
                                    </graphic>
                                </Button>
                            </children>
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>