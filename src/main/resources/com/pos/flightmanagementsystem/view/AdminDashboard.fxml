<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="775.0" prefWidth="1589.0" styleClass="super-dashboard-root" stylesheets="@/com/pos/flightmanagementsystem/Style/AdminDashboardLight.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.AdminDashboardController">
   <left>
      <VBox prefWidth="262.0" spacing="22.0" styleClass="super-sidebar" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="super-brand">
               <children>
                  <StackPane styleClass="super-brand-logo">
                     <children>
                        <SVGPath content="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z" styleClass="super-brand-logo-glyph" />
                     </children>
                  </StackPane>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="super-brand-title" text="FlyPlan" />
                        <Label styleClass="super-brand-kicker" text="Super Admin" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="btnDashboard" mnemonicParsing="false" styleClass="super-nav-button-active" text="Dashboard">
                     <graphic><StackPane styleClass="super-nav-icon"><SVGPath content="M3 13h8V3H3v10Zm0 8h8v-6H3v6Zm10 0h8V11h-8v10Zm0-18v6h8V3h-8Z" styleClass="super-nav-icon-glyph" /></StackPane></graphic>
                  </Button>
                  <Button fx:id="btnFlightSchedule" mnemonicParsing="false" styleClass="super-nav-button" text="Flight Schedule">
                     <graphic><StackPane styleClass="super-nav-icon"><SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" styleClass="super-nav-icon-glyph" /></StackPane></graphic>
                  </Button>
                  <Button fx:id="btnBookingManagement" mnemonicParsing="false" styleClass="super-nav-button" text="Booking Management">
                     <graphic><StackPane styleClass="super-nav-icon"><SVGPath content="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2zm-7 5h5v5h-5z" styleClass="super-nav-icon-glyph" /></StackPane></graphic>
                  </Button>
                  <Button fx:id="btnReport" mnemonicParsing="false" styleClass="super-nav-button" text="System Reports">
                     <graphic><StackPane styleClass="super-nav-icon"><SVGPath content="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6h-6z" styleClass="super-nav-icon-glyph" /></StackPane></graphic>
                  </Button>
               </children>
            </VBox>
            <Button fx:id="btnLogout" mnemonicParsing="false" styleClass="super-logout-button" text="Log Out">
               <graphic><StackPane styleClass="super-nav-icon"><SVGPath content="M10 3H4v18h6v-2H6V5h4V3Zm6.59 5.59L18 10h-8v2h8l-1.41 1.41L18 14.83 21.83 11 18 7.17l-1.41 1.42Z" styleClass="super-nav-icon-glyph" /></StackPane></graphic>
            </Button>
         </children>
      </VBox>
   </left>

   <center>
      <VBox fx:id="contentArea" spacing="24.0" styleClass="super-content" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="super-topbar">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="super-page-kicker" text="SUPER ADMIN DASHBOARD" />
                        <Label styleClass="super-page-title" text="Airline Operations Overview" />
                        <Label styleClass="super-page-subtitle" text="Monitor bookings, flight activity, revenue, and staff actions from one control room." />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- 🌟 KPI Metric Cards (4 Cards) -->
            <HBox spacing="18.0" styleClass="super-metrics-row">
               <children>
                  <!-- 1. Total Revenue -->
                  <StackPane styleClass="super-metric-card-green" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" StackPane.alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="super-metric-label" text="Total Revenue" />
                              <Label fx:id="lblTotalRevenue" styleClass="super-metric-value" text="0 MMK" />
                              <Label styleClass="super-metric-note" text="From Confirmed Bookings" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <!-- 2. Pending Requests (Changed from Total Staff) -->
                  <StackPane styleClass="super-metric-card-blue" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" StackPane.alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="super-metric-label" text="Pending Requests" />
                              <Label fx:id="lblPendingRequests" styleClass="super-metric-value" text="0" />
                              <Label styleClass="super-metric-note" text="Awaiting Approval" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <!-- 3. Active Flights -->
                  <StackPane styleClass="super-metric-card-gold" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" StackPane.alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="super-metric-label" text="Active Flights" />
                              <Label fx:id="lblActiveFlights" styleClass="super-metric-value" text="0" />
                              <Label styleClass="super-metric-note" text="Currently Scheduled" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <!-- 4. Total Bookings -->
                  <StackPane styleClass="super-metric-card-red" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" StackPane.alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="super-metric-label" text="Total Bookings" />
                              <Label fx:id="lblTotalBookings" styleClass="super-metric-value" text="0" />
                              <Label styleClass="super-metric-note" text="All-time Tickets" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
               </children>
            </HBox>

            <!-- 🌟 Main Content Area (Sales Trends & Active Flights) -->
            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="20.0" styleClass="super-panel" HBox.hgrow="ALWAYS">
                     <children>

                        <!-- 📈 Sales Trends Section -->
                        <VBox spacing="10.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="super-section-title" text="Sales Trends" />
                                          <Label styleClass="super-section-subtitle" text="Revenue and ticket sales overview." />
                                       </children>
                                    </VBox>
                                    <!-- ComboBox for Daily, Weekly, Monthly Filter -->
                                    <ComboBox fx:id="cmbSalesFilter" prefWidth="120.0" promptText="Daily" />
                                 </children>
                              </HBox>
                              <LineChart fx:id="chartSalesTrends" prefHeight="220.0">
                                 <xAxis>
                                    <CategoryAxis side="BOTTOM" />
                                 </xAxis>
                                 <yAxis>
                                    <NumberAxis side="LEFT" />
                                 </yAxis>
                              </LineChart>
                           </children>
                        </VBox>

                        <!-- ✈️ Active Flights Table Section -->
                        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="super-section-title" text="Active Flights Overview" />
                                          <Label styleClass="super-section-subtitle" text="Real-time status of flights currently operational." />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <TableView fx:id="tblActiveFlights" prefHeight="250.0" styleClass="super-table" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colFlightNo" prefWidth="100.0" text="Flight No" />
                                    <TableColumn fx:id="colAirline" prefWidth="120.0" text="Airline" />
                                    <TableColumn fx:id="colRoute" prefWidth="160.0" text="Route" />
                                    <TableColumn fx:id="colDepTime" prefWidth="130.0" text="Departure Time" />
                                    <TableColumn fx:id="colArrTime" prefWidth="130.0" text="Arrival Time" />
                                    <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                                 <placeholder>
                                    <Label text="No active flights available" />
                                 </placeholder>
                              </TableView>
                           </children>
                        </VBox>

                     </children>
                  </VBox>

                  <!-- Right Side Panels (Keep Static/Healthy) -->
                  <VBox prefWidth="310.0" spacing="18.0">
                     <children>
                        <VBox spacing="12.0" styleClass="super-side-panel">
                           <children>
                              <Label styleClass="super-section-title" text="System Health" />
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="super-dot-green" text=" " />
                                    <Label styleClass="super-side-copy" text="Database Connected" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="super-dot-blue" text=" " />
                                    <Label styleClass="super-side-copy" text="Booking System Active" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="super-dot-green" text=" " />
                                    <Label styleClass="super-side-copy" text="Server Stable" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <VBox spacing="15.0" styleClass="super-side-panel-accent">
                           <children>
                              <Label styleClass="super-section-title-light" text="Admin Focus" />
                              <Label styleClass="super-side-copy-light" text="Use account management and system tools to keep staff access secure." wrapText="true" />
                           </children>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>