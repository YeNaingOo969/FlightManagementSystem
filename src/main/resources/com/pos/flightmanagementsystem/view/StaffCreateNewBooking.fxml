<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefHeight="680.0" prefWidth="980.0" spacing="25.0" styleClass="main-content-vbox" stylesheets="@/com/pos/flightmanagementsystem/Style/StaffCreateNewBooking.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <!-- Top Header Card -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-card">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <StackPane styleClass="header-icon-container">
                    <children>
                        <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" styleClass="header-icon-glyph" />
                    </children>
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="header-title-label" text="Create New Booking" />
                        <Label styleClass="header-subtitle-label" text="Search and select available flights for booking" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Main Content Container -->
        <HBox spacing="25.0" styleClass="layout-card, search-results-container" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>

                <!-- LEFT Column: Search Form with Icons -->
                <VBox prefWidth="350.0" spacing="18.0" styleClass="search-form-column">
                    <children>
                        <Label styleClass="section-title" text="Search Flight" />

                        <!-- From Field -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="input-label" text="From" />
                                <HBox alignment="CENTER_LEFT" styleClass="input-box-with-icon">
                                    <padding>
                                        <Insets left="12.0" right="12.0" />
                                    </padding>
                                    <children>
                                        <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z" styleClass="field-icon" />
                                        <ComboBox fx:id="fromComboBox" maxWidth="Infinity" promptText="Select Departure" styleClass="custom-combo-box" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- To Field -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="input-label" text="To" />
                                <HBox alignment="CENTER_LEFT" styleClass="input-box-with-icon">
                                    <padding>
                                        <Insets left="12.0" right="12.0" />
                                    </padding>
                                    <children>
                                        <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z" styleClass="field-icon" />
                                        <ComboBox fx:id="toComboBox" maxWidth="Infinity" promptText="Select Destination" styleClass="custom-combo-box" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Departure Date Field -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="input-label" text="Departure Date" />
                                <HBox alignment="CENTER_LEFT" styleClass="input-box-with-icon">
                                    <padding>
                                        <Insets left="12.0" right="12.0" />
                                    </padding>
                                    <children>
                                        <SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" styleClass="field-icon" />
                                        <DatePicker fx:id="departureDatePicker" maxWidth="Infinity" styleClass="custom-date-picker" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Passengers Field -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="input-label" text="Passengers" />
                                <HBox alignment="CENTER_LEFT" styleClass="input-box-with-icon">
                                    <padding>
                                        <Insets left="12.0" right="12.0" />
                                    </padding>
                                    <children>
                                        <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" styleClass="field-icon" />
                                        <Spinner fx:id="passengersSpinner" maxWidth="Infinity" styleClass="custom-spinner" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <Button fx:id="btnSearchFlights" maxWidth="Infinity" styleClass="gradient-button, search-flights-button" text="Search Flights" />
                    </children>
                </VBox>

                <!-- RIGHT Column: Modern Available Flights Table -->
                <VBox spacing="15.0" styleClass="available-flights-column" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="section-title" text="Available Flights" />

                        <TableView fx:id="flightsTable" prefHeight="420.0" styleClass="flights-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colFlightNo" prefWidth="90.0" text="Flight No" />
                                <TableColumn fx:id="colFrom" prefWidth="110.0" text="From" />
                                <TableColumn fx:id="colTo" prefWidth="110.0" text="To" />
                                <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
                                <TableColumn fx:id="colTime" prefWidth="100.0" text="Time" />
                                <TableColumn fx:id="colPrice" prefWidth="90.0" text="Price" />
                                <TableColumn fx:id="colAction" prefWidth="110.0" text="Action" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</VBox>