<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="rootPane" fx:controller="com.pos.flightmanagementsystem.controller.StaffController"
            styleClass="super-dashboard-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="262.0" spacing="22.0" styleClass="super-sidebar" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="super-brand">
                    <children>
                        <StackPane styleClass="super-brand-logo" minWidth="44" maxWidth="44" minHeight="44" maxHeight="44">
                            <children>
                                <SVGPath content="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z" styleClass="super-brand-logo-glyph" />
                            </children>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS" maxWidth="100">
                            <children>
                                <Label styleClass="super-brand-title" text="FlyPlan" />
                                <Label styleClass="super-brand-kicker" text="Staff Portal" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <StackPane fx:id="themeToggleBg" onMouseClicked="#toggleTheme" styleClass="theme-toggle-bg">
                            <StackPane fx:id="themeThumb" styleClass="theme-toggle-thumb" StackPane.alignment="CENTER_LEFT">
                                <SVGPath fx:id="themeIcon" content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" styleClass="theme-icon-glyph" />
                            </StackPane>
                        </StackPane>
                    </children>
                </HBox>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS" styleClass="nav-menu-box">
                    <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#clickDashboard" styleClass="super-nav-button" text="Dashboard">
                            <graphic>
                                <StackPane styleClass="super-nav-icon">
                                    <SVGPath fx:id="iconDashboard" content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" styleClass="super-nav-icon-glyph"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="btnCreateBooking" mnemonicParsing="false" onAction="#clickCreateBooking" styleClass="super-nav-button" text="Create New Booking">
                            <graphic>
                                <StackPane styleClass="super-nav-icon">
                                    <SVGPath fx:id="iconCreateBooking" content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" styleClass="super-nav-icon-glyph"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="btnManageBooking" mnemonicParsing="false" onAction="#clickManageBooking" styleClass="super-nav-button" text="Manage Booking">
                            <graphic>
                                <StackPane styleClass="super-nav-icon">
                                    <SVGPath fx:id="iconManageBooking" content="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" styleClass="super-nav-icon-glyph"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="btnViewSchedule" mnemonicParsing="false" onAction="#clickViewSchedule" styleClass="super-nav-button" text="View Flight Schedule">
                            <graphic>
                                <StackPane styleClass="super-nav-icon">
                                    <SVGPath fx:id="iconViewSchedule" content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" styleClass="super-nav-icon-glyph"/>
                                </StackPane>
                            </graphic>
                        </Button>
                    </children>
                </VBox>

                <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#clickLogout" styleClass="super-logout-button" text="Log Out">
                    <graphic>
                        <StackPane styleClass="super-nav-icon">
                            <SVGPath fx:id="iconLogout" content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" styleClass="super-nav-icon-glyph"/>
                        </StackPane>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- RIGHT MAIN CONTENT AREA & OVERLAYS -->
    <center>
        <StackPane fx:id="rightSideStack" style="-fx-background-color: transparent;">

            <BorderPane fx:id="mainContentWrapper" styleClass="main-content-wrapper">
                <top>
                    <HBox fx:id="topNavBar" styleClass="global-top-nav" BorderPane.alignment="CENTER">
                        <children>
                            <Region HBox.hgrow="ALWAYS" />

                            <!-- 🌟 Notification Bell with Badge 🌟 -->
                            <StackPane fx:id="navNotificationBtn" onMouseClicked="#openNotificationPopup" styleClass="nav-notification-btn">
                                <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" styleClass="nav-bell-icon" />
                                <Label fx:id="notificationBadge" styleClass="notification-badge" text="0" visible="false" StackPane.alignment="TOP_RIGHT">
                                    <StackPane.margin><Insets right="-5" top="-5"/></StackPane.margin>
                                </Label>
                            </StackPane>

                            <!-- Profile Box -->
                            <HBox fx:id="navProfileBox" onMouseClicked="#clickTopNavProfile" styleClass="nav-profile-box">
                                <children>
                                    <StackPane styleClass="nav-profile-avatar">
                                        <Circle fx:id="topNavAvatarCircle" fill="#31C4B4" radius="20.0" />
                                    </StackPane>
                                    <VBox styleClass="nav-profile-text-box">
                                        <children>
                                            <Label fx:id="topNavUsername" styleClass="nav-profile-name" text="Staff User" />
                                            <Label fx:id="topNavRole" styleClass="nav-profile-role" text="STAFF" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                        </children>
                    </HBox>
                </top>
                <center>
                    <StackPane fx:id="mainContentArea" styleClass="main-content-area" BorderPane.alignment="CENTER" />
                </center>
            </BorderPane>

            <!-- Floating Profile Overlay Layer -->
            <StackPane fx:id="profileOverlayBg" visible="false" onMouseClicked="#closeProfilePopup" style="-fx-background-color: rgba(6, 8, 13, 0.6);">
                <children>
                    <StackPane fx:id="profilePopupContainer" maxHeight="-Infinity" maxWidth="-Infinity" StackPane.alignment="CENTER" />
                </children>
            </StackPane>

            <!-- 🌟 Floating Notification Bubble Overlay 🌟 -->
            <!-- 🌟 Floating Notification Bubble Overlay 🌟 -->
            <StackPane fx:id="notificationOverlayBg" onMouseClicked="#closeNotificationPopup" style="-fx-background-color: transparent;" visible="false">
                <children>
                    <!-- 🌟 FXML တွင် TranslateX ကို ဖြုတ်လိုက်ပါသည် (Java Code မှ Name အလိုက် အလိုအလျောက် တွက်ချက်ပေးမည်) 🌟 -->
                    <VBox fx:id="notificationBubble" maxHeight="-Infinity" maxWidth="-Infinity" StackPane.alignment="TOP_RIGHT" translateY="65">
                        <children>
                            <!-- Arrow Pointing Up -->
                            <VBox alignment="TOP_RIGHT" styleClass="noti-arrow-container">
                                <padding><Insets right="40"/></padding>
                                <SVGPath content="M 0 12 L 12 0 L 24 12 Z" styleClass="noti-bubble-arrow"/>
                            </VBox>
                            <!-- Main Bubble Box -->
                            <VBox styleClass="noti-bubble-box" spacing="12">
                                <children>
                                    <Label text="Notifications" styleClass="noti-title"/>
                                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="350" styleClass="noti-scroll-pane">
                                        <content>
                                            <VBox fx:id="notificationListContainer" spacing="10" />
                                        </content>
                                    </ScrollPane>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </children>
            </StackPane>

        </StackPane>
    </center>

    <stylesheets>
        <URL value="@/com/pos/flightmanagementsystem/Style/SuperAdminSideBarDark.css" />
    </stylesheets>
</BorderPane>