<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="acRootPane" styleClass="super-content" stylesheets="@/com/pos/flightmanagementsystem/Style/SuperAdminAccManagementDark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pos.flightmanagementsystem.controller.SuperAdminAccManagementController">
   <children>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="25.0">
         <content>
            <VBox spacing="10.0">
               <children>
                  <HBox maxWidth="1.7976931348623157E308" prefHeight="100.0" spacing="12.0" styleClass="super-topbar" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox prefHeight="84.0" prefWidth="293.0">
                           <children>
                              <Label prefHeight="46.0" prefWidth="330.0" styleClass="page-title" text="Account Management" />
                              <Label styleClass="page-subtitle" text="Manage FlyPlan Airline Staff Accounts" />
                           </children>
                        </VBox>
                        <Region prefHeight="100.0" prefWidth="316.0" />
                        <TextField fx:id="txtSearch" promptText="search here......" styleClass="search-field" />
                        <ComboBox fx:id="comboFilterRole" prefWidth="150.0" promptText="Select Role" styleClass="combo-box" />
                        <Button fx:id="btnCreateUser" mnemonicParsing="false" onAction="#openCreateUser" styleClass="primary-button" text="+ Create User" />
                     </children>
                  </HBox>

                  <HBox prefHeight="100.0" prefWidth="200.0" styleClass="stat-cards-container" VBox.vgrow="ALWAYS">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="super-metric-card-blue" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="98.0" prefWidth="243.0">
                                 <children>
                                    <Label styleClass="super-metric-label" text="Total Users" />
                                    <Label fx:id="lblTotalUsers" styleClass="super-metric-value" text="0 persons" />
                                    <Label styleClass="super-metric-note" text="All registered users" />
                                 </children>
                              </VBox>
                              <StackPane prefHeight="98.0" prefWidth="100.0" styleClass="super-metric-icon">
                                 <children>
                                    <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" styleClass="super-metric-icon-glyph" />
                                 </children>
                              </StackPane>
                           </children>
                        </HBox>
                        <HBox prefHeight="141.0" prefWidth="213.0" styleClass="super-metric-card-carbon" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="98.0" prefWidth="184.0">
                                 <children>
                                    <Label styleClass="super-metric-label" text="Active Users" />
                                    <Label fx:id="lblActiveUsers" styleClass="super-metric-value" text="0 persons" />
                                    <Label styleClass="super-metric-note" text="Currently active" />
                                 </children>
                              </VBox>
                              <StackPane prefHeight="98.0" prefWidth="100.0" styleClass="super-metric-icon">
                                 <children>
                                    <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" styleClass="super-metric-icon-glyph" />
                                 </children>
                              </StackPane>
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="super-metric-card-pink" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="98.0" prefWidth="184.0">
                                 <children>
                                    <Label styleClass="super-metric-label" text="Staff Members" />
                                    <Label fx:id="lblStaffMembers" styleClass="super-metric-value" text="0 persons" />
                                    <Label styleClass="super-metric-note" text="Staff accounts" />
                                 </children>
                              </VBox>
                              <StackPane prefHeight="98.0" prefWidth="100.0" styleClass="super-metric-icon">
                                 <children>
                                    <SVGPath content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" styleClass="super-metric-icon-glyph" />
                                 </children>
                              </StackPane>
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="super-metric-card-violet" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="98.0" prefWidth="184.0">
                                 <children>
                                    <Label styleClass="super-metric-label" text="Administrators" />
                                    <Label fx:id="lblAdministrators" styleClass="super-metric-value" text="0 persons" />
                                    <Label styleClass="super-metric-note" text="Admin accounts" />
                                 </children>
                              </VBox>
                              <StackPane prefHeight="98.0" prefWidth="100.0" styleClass="super-metric-icon">
                                 <children>
                                    <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 6h2v2h-2V7zm0 4h2v6h-2v-6z" styleClass="super-metric-icon-glyph" />
                                 </children>
                              </StackPane>
                           </children>
                        </HBox>
                     </children>
                  </HBox>

                  <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" styleClass="scroll-pane" vbarPolicy="NEVER">
                     <content>
                        <HBox fx:id="profileCardsContainer" styleClass="profile-cards-container" />
                     </content>
                  </ScrollPane>

                  <VBox maxWidth="1.7976931348623157E308" prefHeight="200.0" styleClass="table-card" VBox.vgrow="ALWAYS">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0" spacing="12.0" VBox.vgrow="ALWAYS">
                           <children>
                              <Label styleClass="super-section-title" text="Users" />
                              <Region prefHeight="50.0" prefWidth="706.0" />
                           </children>
                        </HBox>
                        <TableView fx:id="usersTable" minHeight="400.0" prefHeight="450.0" prefWidth="200.0" styleClass="super-table" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colUsername" prefWidth="75.0" text="Username" />
                              <TableColumn fx:id="colPassword" prefWidth="75.0" text="Password" />
                              <TableColumn fx:id="colRole" prefWidth="75.0" text="Role" />
                              <TableColumn fx:id="colEmail" prefWidth="75.0" text="Email" />
                              <TableColumn fx:id="colImagePath" prefWidth="75.0" text="Image Path" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <!-- Toast Notification -->
      <HBox fx:id="notificationToast" prefWidth="340.0" styleClass="toast-notification-dark" visible="false" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0">
         <children>
            <StackPane styleClass="toast-icon-bg">
               <children>
                  <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" styleClass="toast-icon-glyph" />
               </children>
            </StackPane>
            <VBox styleClass="toast-text-box" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblToastTitle" styleClass="toast-title" text="Success!" />
                  <Label fx:id="lblToastMessage" styleClass="toast-message" text="User account created successfully." wrapText="true" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#closeToast" styleClass="toast-close-btn">
               <graphic>
                  <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" styleClass="toast-close-icon" />
               </graphic>
            </Button>
         </children>
      </HBox>

   </children>
</AnchorPane>