<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane centerShape="false" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f0f0f0;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <HBox alignment="CENTER" maxHeight="500.0" maxWidth="800.0" style="-fx-background-color: white; -fx-background-radius: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);">

        <VBox alignment="CENTER_LEFT" prefHeight="512.0" prefWidth="406.0" spacing="20.0" style="-fx-padding: 50; -fx-background-color: linear-gradient(to left, #800000, #000000); -fx-background-radius: 30 0 0 30; -fx-effect: dropshadow(three-pass-box, #8d1212, 20, 0.3, 0, 0); -fx-border-radius: 0 30 30 0;">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label prefHeight="45.0" prefWidth="300.0" style="-fx-font-size: 30px; -fx-text-fill: rgb(206, 221, 233); -fx-font-family: Georgia; -fx-font-weight: bold;" text="ArrLuuu Airline" textFill="WHITE">
                    <font>
                        <Font name="Century Gothic Italic" size="14.769230842590332" />
                    </font>
                </Label>
            </HBox>

            <Label prefHeight="20.0" prefWidth="129.0" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-font-family: Georgia;" text="Welcome Back!" textFill="#8f9d9e">
                <font>
                    <Font name="Georgia" size="14.769230842590332" />
                </font>
            </Label>
            <Label prefHeight="18.0" prefWidth="153.0" style="-fx-text-fill: #8f9d9e; -fx-font-weight: bold; -fx-font-family: Georgia;" text="Sign in to continue" textFill="#899899" />

            <TextField fx:id="txtUsername" prefHeight="45.0" prefWidth="274.0" promptText="Username..." style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-padding: 12; -fx-border-color: rgb(196, 230, 235); -fx-font-family: Georgia; -fx-effect: dropshadow(three-pass-box, white, 10, 0.1, 0, 0);" />
            <TextField fx:id="txtEmail" promptText="Email..." style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-padding: 12; -fx-border-color: rgb(196, 230, 235); -fx-font-family: Georgia; -fx-effect: dropshadow(three-pass-box, white, 10, 0.1, 0, 0);" />
            <PasswordField fx:id="txtPassword" promptText="Password..." style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-padding: 12; -fx-border-color: rgb(196, 230, 235); -fx-font-family: Georgia; -fx-effect: dropshadow(three-pass-box, white, 10, 0.1, 0, 0);" />

            <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#clickLogin" style="-fx-background-radius: 25; -fx-background-color: rgb(117, 14, 14); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-font-family: Georgia; -fx-effect: dropshadow(three-pass-box, black, 10, 0.1, 0, 0);" text="Login" />
            <Hyperlink fx:id="forgotPasswordLink" onAction="#handleForgotPassword" style="-fx-text-fill: rgb(196, 230, 235); -fx-font-size: 12px; -fx-font-family: Georgia;" text="Forgot Password?" />
        </VBox>

        <VBox alignment="CENTER" prefHeight="439.0" prefWidth="400.0" style="-fx-background-color: linear-gradient(to right, #800000, #000000); -fx-background-radius: 0 30 30 0; -fx-effect: dropshadow(three-pass-box, #8d1212, 20, 0.3, 0, 0); -fx-border-radius: 0 30 30 0;" />

    </HBox>
</StackPane>
